#: fd85ebc67cb14bc3bf984930708fe1e9
msgid ""
"ros2 param list\n"
"ros2 param list /ocs2_arm_controller\n"
"ros2 param get /ocs2_arm_controller movel_duration\n"
"ros2 param get /left_gripper_controller force_threshold"
msgstr ""
"ros2 param list\n"
"ros2 param list /ocs2_arm_controller\n"
"ros2 param get /ocs2_arm_controller movel_duration\n"
