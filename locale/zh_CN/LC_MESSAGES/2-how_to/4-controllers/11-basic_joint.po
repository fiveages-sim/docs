#: 1b83964ab86f49e780c10e3a4c864f8a
#, python-brace-format
msgid ""
"ros2 topic pub --once /my_controller/target_joint_position \\\n"
"  std_msgs/msg/Float64MultiArray \"{data: [0.1, 0.2, 0.3]}\""
msgstr ""
"ros2 topic pub --once /my_controller/target_joint_position \\\n"
"  std_msgs/msg/Float64MultiArray \"{data: [0.1, 0.2, 0.3]}\""

#: ../../source/2-how_to/4-controllers/11-basic_joint.md:67
#: d2d0cd6181c848378b2134da13751b77
#, python-brace-format
msgid ""
"Type is `std_msgs/Float64MultiArray`, not `sensor_msgs/JointState`. "
"Optional trajectory: `/{controller}/target_joint_trajectory` "
"(`trajectory_msgs/JointTrajectory`). Hand / waist topics: the reference "
"page (README §5–6)."
msgstr ""
"类型是 `std_msgs/Float64MultiArray`，不是 "
"`sensor_msgs/JointState`。可选轨迹：`/{controller}/target_joint_trajectory`（`trajectory_msgs/JointTrajectory`）。手"
" / 腰话题见参考页（README §5–6）。"

