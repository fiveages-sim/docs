msgid ""
"This demo declares **`type` only**. It does not declare `left_type` / "
"`right_type`. Mixed L/R EEF is on OCS2 `demo` / `split_body` / "
"`full_body` via "
"[robot_common_launch](../../4-reference/descriptions/2-common.md)."
msgstr ""
"此 demo **只声明 `type`**，没有 `left_type` / `right_type`。左右不同末端在 OCS2 的 `demo`"
" / `split_body` / `full_body` 上，见 "
"[robot_common_launch](../../4-reference/descriptions/2-common.md)。"

#: ../../source/2-how_to/4-controllers/11-basic_joint.md:41
#: 68ef90fc783144709a6c99cbf0ae2155
msgid "Switch FSM"
msgstr "切换 FSM"

#: ../../source/2-how_to/4-controllers/11-basic_joint.md:43
#: 5575dc9eec1648ca907aa4b6f0925729
msgid ""
"ros2 topic pub --once /fsm_command std_msgs/msg/Int32 \"data: 1\"   # "
"HOLD → HOME\n"
"ros2 topic pub --once /fsm_command std_msgs/msg/Int32 \"data: 2\"   # → "
"HOLD\n"
"ros2 topic pub --once /fsm_command std_msgs/msg/Int32 \"data: 4\"   # "
"HOLD → MOVEJ (canonical)"
msgstr ""
"ros2 topic pub --once /fsm_command std_msgs/msg/Int32 \"data: 1\"   # "
"HOLD → HOME\n"
"ros2 topic pub --once /fsm_command std_msgs/msg/Int32 \"data: 2\"   # → "
"HOLD\n"
"ros2 topic pub --once /fsm_command std_msgs/msg/Int32 \"data: 4\"   # "
"HOLD → MOVEJ (canonical)"

