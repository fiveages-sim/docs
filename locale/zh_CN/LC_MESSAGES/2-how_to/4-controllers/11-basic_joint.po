#: ../../source/2-how_to/4-controllers/11-basic_joint.md:20
#: 4279172f1962412681d3eef1604b52d4
msgid "Launch (README demo)"
msgstr "启动（README 演示）"

#: ../../source/2-how_to/4-controllers/11-basic_joint.md:22
#: fa11781b33334151a28448e5a87a3e0f
msgid ""
"source ~/open-deploy-ws/install/setup.bash   # or your workspace install/"
"\n"
"\n"
"ros2 launch basic_joint_controller demo.launch.py robot:=fiveages_w1\n"
"# Head only\n"
"ros2 launch basic_joint_controller demo.launch.py robot:=fiveages_w1 "
"enable_body:=false\n"
"# Body only\n"
"ros2 launch basic_joint_controller demo.launch.py robot:=fiveages_w1 "
"enable_head:=false"
msgstr ""
"source ~/open-deploy-ws/install/setup.bash   # or your workspace install/"
"\n"
"\n"
"ros2 launch basic_joint_controller demo.launch.py robot:=fiveages_w1\n"
"# Head only\n"
"ros2 launch basic_joint_controller demo.launch.py robot:=fiveages_w1 "
"enable_body:=false\n"
"# Body only\n"
"ros2 launch basic_joint_controller demo.launch.py robot:=fiveages_w1 "
"enable_head:=false"

