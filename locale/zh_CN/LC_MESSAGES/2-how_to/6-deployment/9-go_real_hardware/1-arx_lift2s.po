msgid "Clone and init"
msgstr "克隆与初始化"

#: ../../source/2-how_to/6-deployment/9-go_real_hardware/1-arx_lift2s.md:18
#: 6a72749c2dc748589ea452bdb77895b4
msgid "Directory name `lift2s-ws` is the example. The workspace repo is public."
msgstr "目录名 `lift2s-ws` 为示例。工作空间仓库本身是公开的。"

#: ../../source/2-how_to/6-deployment/9-go_real_hardware/1-arx_lift2s.md:20
#: a5a2f7ddea54481ebfa83bd0c6573654
msgid "**Public HTTPS** (no SSH key for the top-level clone):"
msgstr "**公开 HTTPS**（顶层克隆不需要 SSH 密钥）："

