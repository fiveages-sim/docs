#: ../../source/2-how_to/9-go_real_hardware.md:141
#: e49c0a60bc1348f99973566e9073b789
msgid "Public Robot Deployment (open-deploy-ws)"
msgstr "公开机器人部署（open-deploy-ws）"

#: ../../source/2-how_to/9-go_real_hardware.md:143
#: dce528ebd7a940d9a017e25115d62454
msgid "ARX Acone"
msgstr "ARX Acone"

#: ../../source/2-how_to/9-go_real_hardware.md:145
#: d0b6a95dc8c444499a7f7d2824761d46
msgid ""
"cd ~/open-deploy-ws\n"
"source install/setup.bash\n"
"\n"
"# Verify CAN interface\n"
"sudo ip link set can0 type can bitrate 1000000\n"
"sudo ip link set can0 up\n"
"\n"
"# Test with mock first\n"
"ros2 launch ocs2_arm_controller demo.launch.py robot:=arx_acone hardware:=mock\n"
"\n"
"# Deploy to real hardware\n"
"ros2 launch ocs2_arm_controller demo.launch.py robot:=arx_acone hardware:=real\n"
msgstr ""
"cd ~/open-deploy-ws\n"
"source install/setup.bash\n"
"\n"
"# Verify CAN interface\n"
"sudo ip link set can0 type can bitrate 1000000\n"
"sudo ip link set can0 up\n"
"\n"
"# Test with mock first\n"
"ros2 launch ocs2_arm_controller demo.launch.py robot:=arx_acone hardware:=mock\n"
"\n"
"# Deploy to real hardware\n"
"ros2 launch ocs2_arm_controller demo.launch.py robot:=arx_acone hardware:=real\n"

#: ../../source/2-how_to/9-go_real_hardware.md:160
#: e631a5a822bd4de694b493f991918d73
msgid "HT Panthera"
msgstr "HT Panthera"

#: ../../source/2-how_to/9-go_real_hardware.md:162
#: 116689e03d2449f38ea5462b07386011
msgid ""
"cd ~/open-deploy-ws\n"
"source install/setup.bash\n"
"\n"
"# Verify serial port (typically /dev/ttyACM0 or /dev/ttyUSB0)\n"
"ls /dev/ttyACM* /dev/ttyUSB*\n"
"\n"
"# Test with mock first\n"
"ros2 launch ocs2_arm_controller demo.launch.py robot:=ht_panthera hardware:=mock\n"
"\n"
"# Deploy to real hardware\n"
"ros2 launch ocs2_arm_controller demo.launch.py robot:=ht_panthera hardware:=real\n"
msgstr ""
"cd ~/open-deploy-ws\n"
"source install/setup.bash\n"
"\n"
"# Verify serial port (typically /dev/ttyACM0 or /dev/ttyUSB0)\n"
"ls /dev/ttyACM* /dev/ttyUSB*\n"
"\n"
"# Test with mock first\n"
"ros2 launch ocs2_arm_controller demo.launch.py robot:=ht_panthera hardware:=mock\n"
