#: ../../source/2-how_to/9-go_real_hardware.md:78
#: a5083c28e9864ceeb4198826c4501fea
msgid "For CAN-based robots:"
msgstr "对于基于 CAN 的机器人："

#: ../../source/2-how_to/9-go_real_hardware.md:79
#: a6014d7a809843e19745d82dea0f51e0
msgid ""
"# Verify CAN interface\n"
"ip link show can0\n"
"\n"
"# Set CAN bitrate if needed\n"
"sudo ip link set can0 type can bitrate 1000000\n"
"sudo ip link set can0 up\n"
msgstr ""
"# Verify CAN interface\n"
"ip link show can0\n"
"\n"
"# Set CAN bitrate if needed\n"
"sudo ip link set can0 type can bitrate 1000000\n"
"sudo ip link set can0 up\n"

#: ../../source/2-how_to/9-go_real_hardware.md:88
#: b3ed82102d614ab791b3757b8bc1138c
msgid "For Ethernet-based robots:"
msgstr "对于基于 Ethernet 的机器人："

#: ../../source/2-how_to/9-go_real_hardware.md:90
#: 36714e3492c34edd80428ee40d2b732b
msgid ""
"# Verify network interface\n"
"ip addr show eth0\n"
msgstr ""
"# Verify network interface\n"
"ip addr show eth0\n"

#: ../../source/2-how_to/9-go_real_hardware.md:95
#: 4f7c822f14ed4a9590d01fb5389f972d
