"# Test all planned motions\n"
msgstr ""
"ros2 launch ocs2_arm_controller demo.launch.py robot:=<your_robot> hardware:=mock\n"
"# Test all planned motions\n"

#: ../../source/2-how_to/9-go_real_hardware.md:74
#: d737a39a68404336957d4ba74db45f1b
msgid "2. Configure Hardware Interface"
msgstr "2. 配置硬件接口"

#: ../../source/2-how_to/9-go_real_hardware.md:76
#: c6a7b2a24ad6403ea202b9a1e09158df
msgid "Set hardware-specific parameters in your configuration."
