#: ../../source/2-how_to/10-add_a_robot.md:134 de5a3d01cd7a4279b8085f1ce7059839
msgid ""
"# config/ocs2_arm_config.yaml\n"
"arm:\n"
"  dof: 6\n"
"  joint_names:\n"
"    - joint_1\n"
"    - joint_2\n"
"    - joint_3\n"
"    - joint_4\n"
"    - joint_5\n"
"    - joint_6\n"
"\n"
"  joint_limits:\n"
"    position:\n"
"      lower: [-3.14, -2.0, -2.5, -3.14, -2.0, -3.14]\n"
"      upper: [3.14, 2.0, 2.5, 3.14, 2.0, 3.14]\n"
"    velocity: [2.0, 2.0, 2.0, 2.5, 2.5, 2.5]\n"
"    effort: [100, 100, 80, 50, 50, 30]\n"
"\n"
"mpc:\n"
"  dt: 0.01\n"
"  horizon: 1.0\n"
"  # MPC tuning parameters...\n"
msgstr ""

