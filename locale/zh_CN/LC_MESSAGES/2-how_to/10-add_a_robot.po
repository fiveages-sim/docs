#: ../../source/2-how_to/10-add_a_robot.md:33 217a087f271d4cdbb522e34c93de8294
msgid "URDF/Xacro"
msgstr ""

#: ../../source/2-how_to/10-add_a_robot.md:35 d82e81f369354ad48bd879ccd61108f7
msgid ""
"<?xml version=\"1.0\"?>\n"
"<robot xmlns:xacro=\"http://www.ros.org/wiki/xacro\" name=\"newrobot\">\n"
"  \n"
"  <!-- Include ros2_control -->\n"
"  <xacro:include filename=\"$(find "
"robot_description_newrobot)/urdf/newrobot.ros2_control.xacro\"/>\n"
"  \n"
"  <!-- Base link -->\n"
"  <link name=\"base_link\">\n"
"    <visual>\n"
"      <geometry>\n"
"        <mesh "
"filename=\"package://robot_description_newrobot/meshes/visual/base.stl\"/>"
"\n"
"      </geometry>\n"
"    </visual>\n"
"    <collision>\n"
"      <geometry>\n"
"        <mesh "
"filename=\"package://robot_description_newrobot/meshes/collision/base.stl\"/>"
"\n"
"      </geometry>\n"
"    </collision>\n"
"    <inertial>\n"
"      <mass value=\"5.0\"/>\n"
"      <inertia ixx=\"0.01\" ixy=\"0\" ixz=\"0\" iyy=\"0.01\" iyz=\"0\" "
"izz=\"0.01\"/>\n"
"    </inertial>\n"
"  </link>\n"
"  \n"
"  <!-- Joints and links... -->\n"
"  \n"
"</robot>\n"
msgstr ""

#: ../../source/2-how_to/10-add_a_robot.md:65 1d4c0fa8ae73409d82e97f69e4512cde
msgid "ros2_control Configuration"
msgstr ""

#: ../../source/2-how_to/10-add_a_robot.md:67 b28408f673984664a47f6003d50fd447
#, python-brace-format
msgid ""
"<?xml version=\"1.0\"?>\n"
"<robot xmlns:xacro=\"http://www.ros.org/wiki/xacro\">\n"
"  \n"
"  <xacro:macro name=\"newrobot_ros2_control\" params=\"hardware_type\">\n"
"    <ros2_control name=\"NewRobotSystem\" type=\"system\">\n"
"      \n"
"      <xacro:if value=\"${hardware_type == 'mock'}\">\n"
"        <hardware>\n"
"          <plugin>mock_components/GenericSystem</plugin>\n"
"        </hardware>\n"
"      </xacro:if>\n"
"      \n"
"      <xacro:if value=\"${hardware_type == 'gz'}\">\n"
"        <hardware>\n"
"          <plugin>gz_ros2_control/GazeboSimSystem</plugin>\n"
"        </hardware>\n"
"      </xacro:if>\n"
"      \n"
"      <xacro:if value=\"${hardware_type == 'real'}\">\n"
"        <hardware>\n"
"          "
"<plugin>newrobot_ros2_control/NewRobotHardwareInterface</plugin>\n"
"          <param name=\"device\">can0</param>\n"
"        </hardware>\n"
"      </xacro:if>\n"
"      \n"
"      <joint name=\"joint_1\">\n"
"        <command_interface name=\"position\"/>\n"
"        <state_interface name=\"position\"/>\n"
"        <state_interface name=\"velocity\"/>\n"
"      </joint>\n"
"      <!-- More joints... -->\n"
"      \n"
"    </ros2_control>\n"
"  </xacro:macro>\n"
"  \n"
"</robot>\n"
msgstr ""

