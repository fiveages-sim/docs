#: ../../source/2-how_to/7-synthetic_data/3-record_export.md:29
#: 7ae9540980b74835b795d59fe1f38b28
msgid ""
"git clone --recursive git@github.com:fiveages-sim/lerobot_ros2.git\n"
"cd lerobot_ros2\n"
"./init.sh all-motion\n"
"# recording / inference (NumPy 2, separate from the grasp env):\n"
"./init.sh install-lerobot\n"
"source .venv/bin/activate"
msgstr ""
"git clone --recursive git@github.com:fiveages-sim/lerobot_ros2.git\n"
"cd lerobot_ros2\n"
"./init.sh all-motion\n"
"# recording / inference (NumPy 2, separate from the grasp env):\n"
"./init.sh install-lerobot\n"
"source .venv/bin/activate"

#: ../../source/2-how_to/7-synthetic_data/3-record_export.md:38
#: 27b75e47e88e4ccab4cf5f528eedfa7a
msgid ""
"`./init.sh all` = submodules + env + task orchestration + LeRobot "
"plugins. Bare `pip install -e .` at the repo root is not the install "
"path."
msgstr ""
"`./init.sh all` = 子模块 + 环境 + 任务编排 + LeRobot 插件。仓库根目录裸 `pip install -e .` "
"不是安装路径。"

