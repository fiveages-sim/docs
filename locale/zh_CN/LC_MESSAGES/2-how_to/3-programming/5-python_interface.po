#: ../../source/2-how_to/3-programming/5-python_interface.md:30
#: 7cad4aa6d0e74baca3c4096697f65ffe
msgid "Connect to Robot"
msgstr "连接到机器人"

#: ../../source/2-how_to/3-programming/5-python_interface.md:32
#: 42420b0f3811418eaac471d880214baf
#, python-brace-format
msgid ""
"from ros2_robot_interface import RobotInterface\n"
"\n"
"# Initialize\n"
"robot = RobotInterface()\n"
"robot.connect()\n"
"\n"
"# Check connection\n"
"print(f\"Connected: {robot.is_connected()}\")"
msgstr ""
"from ros2_robot_interface import RobotInterface\n"
