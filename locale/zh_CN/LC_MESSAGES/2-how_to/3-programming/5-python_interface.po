msgid "Install fa-py-libraries"
msgstr "安装 fa-py-libraries"

#: ../../source/2-how_to/3-programming/5-python_interface.md:13
#: 395c4cea5bc144c7a9ba76cc3dcab581
msgid ""
"cd ~/\n"
"git clone https://github.com/fiveages-sim/fa-py-libraries.git\n"
"cd fa-py-libraries\n"
"./init.sh all    # Python 3.12 env; installs ros2_robot_interface"
