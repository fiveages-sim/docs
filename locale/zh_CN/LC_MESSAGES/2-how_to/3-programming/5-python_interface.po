#: ../../source/2-how_to/3-programming/5-python_interface.md:43
#: 13d2e170f5ab46a49cc42e724fefc81c
msgid "Move Robot"
msgstr "移动机器人"

#: ../../source/2-how_to/3-programming/5-python_interface.md:45
#: e6782280363b43c4a9607c8ecf578d96
msgid ""
"# Move to joint position (radians)\n"
"robot.move_j([0.0, -0.5, 0.5, 0.0, 0.5, 0.0])\n"
"\n"
"# Move to Cartesian pose\n"
"robot.move_l([0.3, 0.0, 0.4], [1.0, 0.0, 0.0, 0.0])  # [x,y,z], "
"[qw,qx,qy,qz]"
msgstr ""
"# Move to joint position (radians)\n"
"robot.move_j([0.0, -0.5, 0.5, 0.0, 0.5, 0.0])\n"
"\n"
"# Move to Cartesian pose\n"
"robot.move_l([0.3, 0.0, 0.4], [1.0, 0.0, 0.0, 0.0])  # [x,y,z], "
"[qw,qx,qy,qz]"

#: ../../source/2-how_to/3-programming/5-python_interface.md:53
#: d52b560b94134b308e696870e01d7dff
msgid "Gripper Control"
msgstr "夹爪控制"

#: ../../source/2-how_to/3-programming/5-python_interface.md:55
#: d8fe3dfbe0bf47e4a43f5752a27704e7
msgid ""
"# Open gripper\n"
"robot.gripper_open()\n"
