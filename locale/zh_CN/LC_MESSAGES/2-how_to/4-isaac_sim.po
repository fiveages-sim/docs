"./run.sh --robot galbot\n"
"\n"
"# Corresponding ROS 2 launch\n"
"ros2 launch ocs2_arm_controller demo.launch.py robot:=galbot "
"hardware:=isaac\n"
msgstr ""
"# Edit FaSim-Isaac config or use command line\n"
"./run.sh --robot galbot\n"
"\n"
"# Corresponding ROS 2 launch\n"
"ros2 launch ocs2_arm_controller demo.launch.py robot:=galbot "
"hardware:=isaac\n"

