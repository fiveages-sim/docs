#: ../../source/2-how_to/4-isaac_sim.md:1 433af527b5054232a21c11bf6dfabdf9
msgid "Isaac Sim"
msgstr "Isaac Sim"

#: ../../source/2-how_to/4-isaac_sim.md:3 1e4ee5b06d3048a1ba343089fe11684f
msgid "Run robot demos with NVIDIA Isaac Sim for high-fidelity simulation."
msgstr "使用 NVIDIA Isaac Sim 运行高保真仿真机器人演示。"

#: ../../source/2-how_to/4-isaac_sim.md:5 5866adb883d64f4bb176f14d4b8b0335
msgid "Required Version and Path"
msgstr "所需版本与路径"

#: ../../source/2-how_to/4-isaac_sim.md:8 64a16a0357e742b8be99582468783bc5
msgid ""
"FaSim-Isaac requires **Isaac Sim 6.1** installed at **`~/isaacsim`**. The"
" run scripts assume this exact path. Other versions or paths will not "
"work without modifying the scripts."
msgstr ""
"FaSim-Isaac 需要将 **Isaac Sim 6.1** 安装在 "
"**`~/isaacsim`**。运行脚本假定使用该精确路径。其他版本或路径在未修改脚本的情况下无法使用。"

#: ../../source/2-how_to/4-isaac_sim.md:11 782760f9d0504a4c9d44f6e3696d31bf
msgid "Prerequisites"
msgstr "前提条件"

#: ../../source/2-how_to/4-isaac_sim.md:13 88470245d3144b22b60d277e6cf171d6
msgid "**Isaac Sim 6.1 binary** installed at `~/isaacsim`"
msgstr "**Isaac Sim 6.1 二进制包**已安装到 `~/isaacsim`"

#: ../../source/2-how_to/4-isaac_sim.md:14 447c2172696343c4832c5cb9da03c162
msgid "NVIDIA GPU (RTX recommended)"
msgstr "NVIDIA GPU（推荐 RTX）"

#: ../../source/2-how_to/4-isaac_sim.md:15 41b9675385e44272b9a913769a4d98b7
msgid "NVIDIA drivers compatible with Isaac Sim 6.1"
msgstr "与 Isaac Sim 6.1 兼容的 NVIDIA 驱动"

#: ../../source/2-how_to/4-isaac_sim.md:16 28b9290b5cfc4f218899eab4a6ef8a99
msgid "ROS 2 Jazzy workspace"
msgstr "ROS 2 Jazzy 工作空间"

#: ../../source/2-how_to/4-isaac_sim.md:18 35fe2488205b4934b3b0895610a7e511
msgid "Steps"
msgstr "步骤"

#: ../../source/2-how_to/4-isaac_sim.md:20 7ad07ea5cec044c2b07e4d96ab59da02
msgid "1. Clone FaSim-Isaac"
msgstr "1. 克隆 FaSim-Isaac"

#: ../../source/2-how_to/4-isaac_sim.md:22 b1edff4fd60147fe81ae3dede22e8816
msgid ""
"cd ~/\n"
"git clone https://github.com/fiveages-sim/FaSim-Isaac.git\n"
"cd FaSim-Isaac\n"
msgstr ""
"cd ~/\n"
"git clone https://github.com/fiveages-sim/FaSim-Isaac.git\n"
"cd FaSim-Isaac\n"

#: ../../source/2-how_to/4-isaac_sim.md:28 210a735f95a04729a490f64d5a06a1f6
msgid "2. Initialize"
msgstr "2. 初始化"

#: ../../source/2-how_to/4-isaac_sim.md:30 880ff011db454bfea53b78ac647a7605
msgid "./init.sh\n"
msgstr "./init.sh\n"

#: ../../source/2-how_to/4-isaac_sim.md:34 9a8701e06c0249b6a4523b3a6f52aea8
msgid "This initializes:"
msgstr "这将初始化："

#: ../../source/2-how_to/4-isaac_sim.md:35 72503cd645cd4313bdb38ede33142a93
msgid "`robot_usds` submodule (USD robot assets)"
msgstr "`robot_usds` 子模块（USD 机器人资产）"

#: ../../source/2-how_to/4-isaac_sim.md:36 ac3c2c551f0f47b0a12eb2ad260e1a50
msgid "Environment assets"
msgstr "环境资产"

#: ../../source/2-how_to/4-isaac_sim.md:37 0f3e8be3747f42c4ab680e49c26e6675
msgid "Configuration files"
msgstr "配置文件"

#: ../../source/2-how_to/4-isaac_sim.md:39 29927632ca724857afa940d3ae179707
msgid "3. Start Isaac Sim"
msgstr "3. 启动 Isaac Sim"

#: ../../source/2-how_to/4-isaac_sim.md:41 33834c73726c4e6d91e2acee82408451
msgid "./run.sh\n"
msgstr "./run.sh\n"

#: ../../source/2-how_to/4-isaac_sim.md:45 88ac87652201473394ba7346ed4233f1
msgid ""
"This launches Isaac Sim with the configured scene. The script expects "
"Isaac Sim 6.1 at `~/isaacsim`."
msgstr "这将启动 Isaac Sim 并加载已配置的场景。脚本要求 Isaac Sim 6.1 位于 `~/isaacsim`。"

#: ../../source/2-how_to/4-isaac_sim.md:47 d29bc47b00a8499d9389cf3cb61e0f34
msgid "Path Verification"
msgstr "路径验证"

#: ../../source/2-how_to/4-isaac_sim.md:50 a393472185ca4b71983a1e9f07cc3076
msgid "Verify your installation path before running:"
msgstr "运行前请确认安装路径："

#: ../../source/2-how_to/4-isaac_sim.md:52 e851ccd99afe443088fc2c75131dcbc7
msgid "ls ~/isaacsim/python.sh\n"
msgstr "ls ~/isaacsim/python.sh\n"

#: ../../source/2-how_to/4-isaac_sim.md:56 ea86f59ed6634beab6a130fac1aeaf8a
msgid ""
"If this file doesn't exist, either install Isaac Sim 6.1 to `~/isaacsim` "
"or create a symlink."
msgstr "如果该文件不存在，请将 Isaac Sim 6.1 安装到 `~/isaacsim`，或创建符号链接。"

#: ../../source/2-how_to/4-isaac_sim.md:59 9d4fcd4069bf44149eca66c28ca42bd2
msgid "4. Launch ROS 2 Side"
msgstr "4. 启动 ROS 2 侧"

#: ../../source/2-how_to/4-isaac_sim.md:61 b019b11e99a145b2a0f6725fee2140e8
msgid "In a new terminal:"
msgstr "在新终端中："

#: ../../source/2-how_to/4-isaac_sim.md:63 aa5d605266564a019c384c0c606369cf
msgid ""
"source /opt/ros/jazzy/setup.bash\n"
"source ~/open-deploy-ws/install/setup.bash\n"
"ros2 launch ocs2_arm_controller demo.launch.py hardware:=isaac\n"
msgstr ""
"source /opt/ros/jazzy/setup.bash\n"
"source ~/open-deploy-ws/install/setup.bash\n"
"ros2 launch ocs2_arm_controller demo.launch.py hardware:=isaac\n"

#: ../../source/2-how_to/4-isaac_sim.md:69 a1a8e417bdb44d60ae496c5ff25e1e84
msgid "5. Verify Connection"
msgstr "5. 验证连接"

#: ../../source/2-how_to/4-isaac_sim.md:71 ccfc7482a63c492a87ec5c1bdca28e8e
msgid "Check topics are bridged:"
msgstr "确认话题已桥接："

#: ../../source/2-how_to/4-isaac_sim.md:73 ab96efb3ed5c44358c9fcd6bffc6d57a
msgid ""
"ros2 topic list\n"
"# Should see /joint_states, /target_pose, etc.\n"
msgstr ""
"ros2 topic list\n"
"# Should see /joint_states, /target_pose, etc.\n"

