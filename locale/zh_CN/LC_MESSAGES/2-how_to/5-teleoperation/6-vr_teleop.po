msgid "Set firewall rules for ROS 2 ports"
msgstr "为 ROS 2 端口设置防火墙规则"

#: ../../source/2-how_to/5-teleoperation/6-vr_teleop.md:227
#: 103be02a84e4494699b1bff176470d0e
msgid "Verification"
msgstr "验证"

#: ../../source/2-how_to/5-teleoperation/6-vr_teleop.md:229
#: 32af3deb23eb437a9a672d50e294167e
msgid "VR bridge logs show tracking data"
msgstr "VR 桥接日志显示追踪数据"

