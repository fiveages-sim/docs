msgstr "USB 网络共享；**使用自己的 App**，与消费版 Pico App 分开"

#: ../../source/2-how_to/5-teleoperation/6-vr_teleop.md
#: 0def7cbf57a14e76871eec0e1d9933ac
msgid "**Pico consumer**"
msgstr "**Pico 消费版**"

#: ../../source/2-how_to/5-teleoperation/6-vr_teleop.md
#: 9e8648accb884eb79061c35725040520 d194299324b349019cab30555e313009
msgid "Supported"
msgstr "支持"

#: ../../source/2-how_to/5-teleoperation/6-vr_teleop.md
#: 54ee3aeb41b94b55a2bb2a3578fc1c0a
msgid "Its own headset App; Wi-Fi to the ROS 2 PC"
msgstr "使用自己的头显 App；通过 Wi-Fi 连到 ROS 2 主机"

#: ../../source/2-how_to/5-teleoperation/6-vr_teleop.md
#: 14af6f4135ec4c2f98f7d08c7cea48a7
