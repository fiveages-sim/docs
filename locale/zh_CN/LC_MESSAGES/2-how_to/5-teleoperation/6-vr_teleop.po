msgstr "确认目标位姿在工作空间内"

#: ../../source/2-how_to/5-teleoperation/6-vr_teleop.md:305
#: 47feca6879f048188c88586e40fee71a
msgid "Ensure no safety limits are triggered"
msgstr "确认没有触发安全限位"

