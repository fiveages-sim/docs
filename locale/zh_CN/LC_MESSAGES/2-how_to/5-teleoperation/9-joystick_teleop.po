#: ../../source/2-how_to/5-teleoperation/9-joystick_teleop.md:19
#: 98aaaab4816f493b955cae7ada6a1492
msgid "High / low speed"
msgstr "高速 / 低速"

#: ../../source/2-how_to/5-teleoperation/9-joystick_teleop.md:19
#: a3f2f882d774401e86ee356dcd9ce3ce
msgid "**A**"
msgstr "**A**"

#: ../../source/2-how_to/5-teleoperation/9-joystick_teleop.md:19
#: 3ec132636a6b4e2b8036fdf9751fc875
msgid "Switch the active arm (arm mode)"
msgstr "切换当前手臂（手臂模式）"

#: ../../source/2-how_to/5-teleoperation/9-joystick_teleop.md:19
#: 4ee4af39b2fd4680a476783cb32d201f
msgid "**X**"
msgstr "**X**"

#: ../../source/2-how_to/5-teleoperation/9-joystick_teleop.md:19
#: df1fd1ec40404b1ab124260f00fc898b
msgid "Gripper open / close"
msgstr "夹爪开 / 合"

