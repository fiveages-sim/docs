#: 5aa85f583cd540b6b4caa03e1482fbc0
msgid "**LT** / **RT**"
msgstr "**LT** / **RT**"

#: ../../source/2-how_to/5-teleoperation/9-joystick_teleop.md:19
#: 9b54a63e10d141629d188773236f38d2
msgid "Gripper open ratio"
msgstr "夹爪张开比例"

