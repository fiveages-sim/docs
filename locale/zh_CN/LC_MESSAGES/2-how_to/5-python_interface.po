msgstr "手动回退"

#: ../../source/2-how_to/5-python_interface.md:25
#: a0e2525b6fa34761b62d7327e8c1fe9c
msgid ""
"`pip install ros2-robot-interface` on system Python is not the documented "
"entry. If you must install the package alone, do it inside the fa-py-"
"libraries env after `./init.sh env 3.12`."
msgstr ""
"在系统 Python 上 `pip install ros2-robot-interface` 不是文档主入口。若必须单独装这个包，请在 "
"`./init.sh env 3.12` 之后的 fa-py-libraries 环境内安装。"

#: ../../source/2-how_to/5-python_interface.md:28
#: 92b350cc0ea54203a0bdc5f45e0db175
msgid "Basic Usage"
msgstr "基本用法"

#: ../../source/2-how_to/5-python_interface.md:30
#: e517808f47a64b42beaab61ced53e58e
msgid "Connect to Robot"
msgstr "连接到机器人"

#: ../../source/2-how_to/5-python_interface.md:32
#: 104b94be236d49f7b7b709bf1d0e5a3c
#, python-brace-format
msgid ""
"from ros2_robot_interface import RobotInterface\n"
"\n"
"# Initialize\n"
"robot = RobotInterface()\n"
"robot.connect()\n"
"\n"
"# Check connection\n"
"print(f\"Connected: {robot.is_connected()}\")"
msgstr ""
"from ros2_robot_interface import RobotInterface\n"
"\n"
"# Initialize\n"
"robot = RobotInterface()\n"
"robot.connect()\n"
"\n"
"# Check connection\n"
"print(f\"Connected: {robot.is_connected()}\")"

#: ../../source/2-how_to/5-python_interface.md:43
#: 1d2767a146e9429ebada53b937befa4d
msgid "Move Robot"
msgstr "移动机器人"

#: ../../source/2-how_to/5-python_interface.md:45
#: 3447016df27d4b0384d7ed4905623987
msgid ""
"# Move to joint position (radians)\n"
"robot.move_j([0.0, -0.5, 0.5, 0.0, 0.5, 0.0])\n"
"\n"
"# Move to Cartesian pose\n"
"robot.move_l([0.3, 0.0, 0.4], [1.0, 0.0, 0.0, 0.0])  # [x,y,z], [qw,qx,qy,qz]"
msgstr ""
"# Move to joint position (radians)\n"
"robot.move_j([0.0, -0.5, 0.5, 0.0, 0.5, 0.0])\n"
"\n"
"# Move to Cartesian pose\n"
"robot.move_l([0.3, 0.0, 0.4], [1.0, 0.0, 0.0, 0.0])  # [x,y,z], [qw,qx,qy,qz]"

#: ../../source/2-how_to/5-python_interface.md:53
#: 654f43a309b84b8bbaa6681047d513cb
msgid "Gripper Control"
msgstr "夹爪控制"

#: ../../source/2-how_to/5-python_interface.md:55
#: 7245d9b10c2142fa828fa03776cd778b
msgid ""
"# Open gripper\n"
"robot.gripper_open()\n"
"\n"
"# Close gripper\n"
"robot.gripper_close()\n"
"\n"
"# Set position (0.0 = closed, 1.0 = open)\n"
"robot.gripper_move(0.5)"
msgstr ""
"# Open gripper\n"
"robot.gripper_open()\n"
"\n"
"# Close gripper\n"
"robot.gripper_close()\n"
"\n"
"# Set position (0.0 = closed, 1.0 = open)\n"
"robot.gripper_move(0.5)"

#: ../../source/2-how_to/5-python_interface.md:66
#: b96e626128f94440b0dc9d0604083a97
