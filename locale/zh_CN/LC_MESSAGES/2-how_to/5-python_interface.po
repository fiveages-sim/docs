#: ../../source/2-how_to/5-python_interface.md:153
#: 98556cd677bf43b6a9847e9ec44ed3a6
msgid "Async Interface"
msgstr ""

#: ../../source/2-how_to/5-python_interface.md:155
#: 9351701a622746d7b74721fa0ba7c57d
msgid "For non-blocking operations:"
msgstr ""

#: ../../source/2-how_to/5-python_interface.md:157
#: d655e091cccc4ceaa3a78ff0edfbefa5
msgid ""
"import asyncio\n"
"from ros2_robot_interface import AsyncRobotInterface\n"
"\n"
"async def main():\n"
"    robot = AsyncRobotInterface()\n"
"    await robot.connect()\n"
"    \n"
"    # Non-blocking motion\n"
"    await robot.move_j_async([0.0, -0.5, 0.5, 0.0, 0.5, 0.0])\n"
"    \n"
"    # Do other things while moving\n"
"    while robot.is_moving():\n"
"        print(\"Moving...\")\n"
"        await asyncio.sleep(0.1)\n"
"    \n"
"    print(\"Done!\")\n"
"\n"
"asyncio.run(main())\n"
msgstr ""

