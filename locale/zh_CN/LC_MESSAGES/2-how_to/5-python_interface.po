#: ../../source/2-how_to/5-python_interface.md:149
#: b84c4552dde04533b820452cf8175322
msgid "Async Interface"
msgstr "异步接口"

#: ../../source/2-how_to/5-python_interface.md:151
#: 08b7b367694c48bd9607cf341aef325f
msgid "For non-blocking operations:"
msgstr "用于非阻塞操作："

#: ../../source/2-how_to/5-python_interface.md:153
#: 516df0e364224334b5e232c2a258d597
msgid ""
"import asyncio\n"
"from ros2_robot_interface import AsyncRobotInterface\n"
"\n"
"async def main():\n"
"    robot = AsyncRobotInterface()\n"
"    await robot.connect()\n"
"    \n"
"    # Non-blocking motion\n"
"    await robot.move_j_async([0.0, -0.5, 0.5, 0.0, 0.5, 0.0])\n"
"    \n"
"    # Do other things while moving\n"
"    while robot.is_moving():\n"
"        print(\"Moving...\")\n"
"        await asyncio.sleep(0.1)\n"
"    \n"
"    print(\"Done!\")\n"
"\n"
"asyncio.run(main())"
msgstr ""
"import asyncio\n"
"from ros2_robot_interface import AsyncRobotInterface\n"
"\n"
"async def main():\n"
"    robot = AsyncRobotInterface()\n"
"    await robot.connect()\n"
"    \n"
"    # Non-blocking motion\n"
"    await robot.move_j_async([0.0, -0.5, 0.5, 0.0, 0.5, 0.0])\n"
"    \n"
"    # Do other things while moving\n"
"    while robot.is_moving():\n"
"        print(\"Moving...\")\n"
"        await asyncio.sleep(0.1)\n"
"    \n"
"    print(\"Done!\")\n"
"\n"
"asyncio.run(main())"

