#: ../../source/2-how_to/5-python_interface.md:153
#: f87d0f2b6072418abaa2b107fdecc047
msgid "Async Interface"
msgstr "异步接口"

#: ../../source/2-how_to/5-python_interface.md:155
#: f0d29de220f04ad6a6530369aebef816
msgid "For non-blocking operations:"
msgstr "用于非阻塞操作："

#: ../../source/2-how_to/5-python_interface.md:157
#: 6c6a3df04ee54ff4a9dbb960a1ee770a
msgid ""
"import asyncio\n"
"from ros2_robot_interface import AsyncRobotInterface\n"
"\n"
"async def main():\n"
"    robot = AsyncRobotInterface()\n"
"    await robot.connect()\n"
"    \n"
"    # Non-blocking motion\n"
"    await robot.move_j_async([0.0, -0.5, 0.5, 0.0, 0.5, 0.0])\n"
"    \n"
"    # Do other things while moving\n"
"    while robot.is_moving():\n"
"        print(\"Moving...\")\n"
"        await asyncio.sleep(0.1)\n"
"    \n"
"    print(\"Done!\")\n"
"\n"
"asyncio.run(main())\n"
msgstr ""
"import asyncio\n"
"from ros2_robot_interface import AsyncRobotInterface\n"
"\n"
"async def main():\n"
"    robot = AsyncRobotInterface()\n"
"    await robot.connect()\n"
"    \n"
"    # Non-blocking motion\n"
"    await robot.move_j_async([0.0, -0.5, 0.5, 0.0, 0.5, 0.0])\n"
"    \n"
"    # Do other things while moving\n"
"    while robot.is_moving():\n"
"        print(\"Moving...\")\n"
"        await asyncio.sleep(0.1)\n"
"    \n"
"    print(\"Done!\")\n"
"\n"
"asyncio.run(main())\n"

#: ../../source/2-how_to/5-python_interface.md:178
#: 2f5d0e4b273449b8b2ffaf7eef20fee6
msgid "Verification"
msgstr "验证"

#: ../../source/2-how_to/5-python_interface.md:180
#: b761144bb2cf451a9b96cf43756ad742
#, python-brace-format
msgid ""
"# Test script\n"
"from ros2_robot_interface import RobotInterface\n"
"\n"
"robot = RobotInterface()\n"
"robot.connect()\n"
"\n"
"# Read current state\n"
"print(f\"Joints: {robot.get_joint_positions()}\")\n"
"print(f\"EE Pose: {robot.get_ee_pose()}\")\n"
"\n"
"# Small motion test\n"
"current = robot.get_joint_positions()\n"
"current[0] += 0.1  # Small rotation of first joint\n"
"robot.move_j(current)\n"
msgstr ""
"# Test script\n"
"from ros2_robot_interface import RobotInterface\n"
"\n"
"robot = RobotInterface()\n"
"robot.connect()\n"
"\n"
"# Read current state\n"
"print(f\"Joints: {robot.get_joint_positions()}\")\n"
"print(f\"EE Pose: {robot.get_ee_pose()}\")\n"
"\n"
"# Small motion test\n"
"current = robot.get_joint_positions()\n"
"current[0] += 0.1  # Small rotation of first joint\n"
"robot.move_j(current)\n"

