msgstr ""

#: ../../source/2-how_to/5-python_interface.md:41
#: 192cbca51af3497590c75568a63ab242
msgid "Move Robot"
msgstr ""

#: ../../source/2-how_to/5-python_interface.md:43
#: 5cb8fdc379b042909ae292a8425c59ee
msgid ""
"# Move to joint position (radians)\n"
"robot.move_j([0.0, -0.5, 0.5, 0.0, 0.5, 0.0])\n"
"\n"
"# Move to Cartesian pose\n"
"robot.move_l([0.3, 0.0, 0.4], [1.0, 0.0, 0.0, 0.0])  # [x,y,z], "
"[qw,qx,qy,qz]\n"
msgstr ""

#: ../../source/2-how_to/5-python_interface.md:51
#: ff30b8ca64e3476ba6d69c364bfd4097
msgid "Gripper Control"
msgstr ""

#: ../../source/2-how_to/5-python_interface.md:53
#: ea8f8d0e2fcc4d6b93393415cb89bf74
msgid ""
"# Open gripper\n"
"robot.gripper_open()\n"
"\n"
"# Close gripper\n"
"robot.gripper_close()\n"
"\n"
"# Set position (0.0 = closed, 1.0 = open)\n"
"robot.gripper_move(0.5)\n"
msgstr ""

#: ../../source/2-how_to/5-python_interface.md:64
