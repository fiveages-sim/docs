msgid ""
"# Joint positions\n"
"joints = robot.get_joint_positions()\n"
"print(f\"Joints: {joints}\")\n"
"\n"
"# End-effector pose\n"
"pose = robot.get_ee_pose()\n"
"print(f\"EE pose: {pose}\")"
