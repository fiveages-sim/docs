#: ../../source/2-how_to/1-basic_operations/1-run_mock_demo.md:1
#: 75fd8d8321894e5abd7f9887c7562499
msgid "Run Mock Demo"
msgstr "运行模拟演示"

#: ../../source/2-how_to/1-basic_operations/1-run_mock_demo.md:3
#: 1bb1b654047d4700b0dca08b0182be44
msgid ""
"Run a robot demonstration in mock hardware mode without physical hardware"
" or simulation."
msgstr "在模拟硬件模式下运行机器人演示，无需实体硬件或仿真。"

#: ../../source/2-how_to/1-basic_operations/1-run_mock_demo.md:5
#: d4be377c030e4529813c66d9444b69a7
msgid "Prerequisites"
msgstr "前提条件"

#: ../../source/2-how_to/1-basic_operations/1-run_mock_demo.md:7
#: 164f5c235cc748ac9dceab63f8e7c1a6
msgid "Workspace built and sourced"
msgstr "工作空间已编译并已执行 source"

#: ../../source/2-how_to/1-basic_operations/1-run_mock_demo.md:8
#: 4ed1bec0b0054dcbad4a9a6c3a68bb93
msgid "RViz2 installed (`ros-jazzy-rviz2`)"
msgstr "已安装 RViz2（`ros-jazzy-rviz2`）"

#: ../../source/2-how_to/1-basic_operations/1-run_mock_demo.md:10
#: 1c4ee0a1fed140649ae7c902fa2a8f16
msgid "Steps"
msgstr "步骤"

#: ../../source/2-how_to/1-basic_operations/1-run_mock_demo.md:12
#: fae6b6853f804762971a0c1be2e6d4c1
msgid "1. Source Workspace"
msgstr "1. 源 工作空间"

#: ../../source/2-how_to/1-basic_operations/1-run_mock_demo.md:14
#: b02668bc9ac24b87b635eb76ed2693db
msgid ""
"source /opt/ros/jazzy/setup.bash\n"
"source ~/open-deploy-ws/install/setup.bash\n"
msgstr ""
"source /opt/ros/jazzy/setup.bash\n"
"source ~/open-deploy-ws/install/setup.bash\n"

#: ../../source/2-how_to/1-basic_operations/1-run_mock_demo.md:19
#: 9676e017301349e98fc4d5bc74d8395e
msgid "2. Launch Mock Demo"
msgstr "2. 启动模拟演示"

#: ../../source/2-how_to/1-basic_operations/1-run_mock_demo.md:21
#: cbff524b58d84de8a792ec1cb06cf3a3
msgid "ros2 launch ocs2_arm_controller demo.launch.py hardware:=mock\n"
msgstr "ros2 launch ocs2_arm_controller demo.launch.py hardware:=mock\n"

#: ../../source/2-how_to/1-basic_operations/1-run_mock_demo.md:25
#: 57152ce001a04da9b5159eb132aa4049
msgid "3. Send Target Pose"
msgstr "3. 发送目标位姿"

#: ../../source/2-how_to/1-basic_operations/1-run_mock_demo.md:27
#: a67b9978bb4a4d69a7da25b828ad2223
msgid "In a new terminal:"
msgstr "在新终端中："

#: ../../source/2-how_to/1-basic_operations/1-run_mock_demo.md:29
#: c6518bd349804acf8aa20c61f5666ba5
#, python-brace-format
msgid ""
"source ~/open-deploy-ws/install/setup.bash\n"
"ros2 topic pub /target_pose geometry_msgs/msg/PoseStamped \\\n"
"  \"{header: {frame_id: 'base_link'}, pose: {position: {x: 0.3, y: 0.1, "
"z: 0.4}, orientation: {w: 1.0}}}\" \\\n"
"  --once\n"
msgstr ""
"source ~/open-deploy-ws/install/setup.bash\n"
"ros2 topic pub /target_pose geometry_msgs/msg/PoseStamped \\\n"
"  \"{header: {frame_id: 'base_link'}, pose: {position: {x: 0.3, y: 0.1, "
"z: 0.4}, orientation: {w: 1.0}}}\" \\\n"
"  --once\n"

#: ../../source/2-how_to/1-basic_operations/1-run_mock_demo.md:36
#: 83ae59155aac4e08bbc6a175ab0f5462
msgid "4. Observe Motion"
msgstr "4. 观察运动"

#: ../../source/2-how_to/1-basic_operations/1-run_mock_demo.md:38
#: bd2b41d1816446859bd899ae868f90d4
msgid "Watch RViz — the robot should move to the target pose."
msgstr "观察 RViz — 机器人应移动到目标位姿。"

#: ../../source/2-how_to/1-basic_operations/1-run_mock_demo.md:40
#: ff92d8d92773446080705d3a572b89c2
msgid "With Different Robots"
msgstr "使用不同机器人"

#: ../../source/2-how_to/1-basic_operations/1-run_mock_demo.md:42
#: f741ac1ac53e4416b66f05f685ee8539
msgid ""
"# Dobot CR5\n"
"ros2 launch ocs2_arm_controller demo.launch.py robot:=dobot_cr5 "
"hardware:=mock\n"
"\n"
"# Acone (arm only, not Lift 2S)\n"
"ros2 launch ocs2_arm_controller demo.launch.py robot:=arx_acone "
"hardware:=mock\n"
"\n"
"# HighTorque Panthera HT\n"
"ros2 launch ocs2_arm_controller demo.launch.py robot:=panthera_ht "
"hardware:=mock\n"
msgstr ""
"# Dobot CR5\n"
"ros2 launch ocs2_arm_controller demo.launch.py robot:=dobot_cr5 "
"hardware:=mock\n"
"\n"
"# Acone (arm only, not Lift 2S)\n"
"ros2 launch ocs2_arm_controller demo.launch.py robot:=arx_acone "
"hardware:=mock\n"
"\n"
"# HighTorque Panthera HT\n"
"ros2 launch ocs2_arm_controller demo.launch.py robot:=panthera_ht "
"hardware:=mock\n"

#: ../../source/2-how_to/1-basic_operations/1-run_mock_demo.md:53
#: 10238239c3d94ba1aff90845bde0362d
msgid "End-effector (`type`)"
msgstr "末端执行器（`type`）"

#: ../../source/2-how_to/1-basic_operations/1-run_mock_demo.md:55
#: b68ebcf05996466bbbddaee7155b8b20
msgid ""
"Not `gripper:=`. This launch includes "
"`create_robot_profile_launch_arguments()`. Symmetric EEF: `type:=`. "
"Different L/R: `left_type:=` and `right_type:=` together (**do not pass "
"`type:=`** then). Profile `defaults.end_effectors` applies unless "
"`use_profile_eef:=false`. See [Switch Robot](2-switch_robot.md) and "
"[robot_common_launch](../../4-reference/descriptions/2-common.md)."
msgstr ""
"不是 `gripper:=`。此 launch 包含 `create_robot_profile_launch_arguments()`。对称末端：`type:=`。左右不同：同时传 `left_type:=` 与 `right_type:=`（此时**不要再传 `type:=`**）。除非 `use_profile_eef:=false`，否则使用 profile 的 `defaults.end_effectors`。见 [切换机器人](2-switch_robot.md) 与 [robot_common_launch](../../4-reference/descriptions/2-common.md)。"

#: ../../source/2-how_to/1-basic_operations/1-run_mock_demo.md:57
#: 157f62858cc34ee492a61de4331b5b95
msgid ""
"ros2 launch ocs2_arm_controller demo.launch.py \\\n"
"  robot:=<robot_name> \\\n"
"  use_profile_eef:=false \\\n"
"  left_type:=rg75 right_type:=linkerhand_o7 \\\n"
"  hardware:=mock"
msgstr ""
"ros2 launch ocs2_arm_controller demo.launch.py \\\n"
"  robot:=<robot_name> \\\n"
"  use_profile_eef:=false \\\n"
"  left_type:=rg75 right_type:=linkerhand_o7 \\\n"
"  hardware:=mock"

