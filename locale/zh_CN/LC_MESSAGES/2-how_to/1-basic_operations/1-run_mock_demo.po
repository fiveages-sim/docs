msgstr "使用不同机器人"

#: ../../source/2-how_to/1-basic_operations/1-run_mock_demo.md:39
#: b74d2b299eed482e8ffd143007e84be5
msgid ""
"# Acone (dual-arm, not Lift 2S)\n"
"ros2 launch ocs2_arm_controller demo.launch.py robot:=arx_acone\n"
"\n"
"# HighTorque Panthera HT\n"
"ros2 launch ocs2_arm_controller demo.launch.py robot:=panthera_ht\n"
