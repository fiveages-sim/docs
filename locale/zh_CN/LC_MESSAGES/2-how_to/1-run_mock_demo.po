#: ../../source/2-how_to/1-run_mock_demo.md:1 43ca5ab449d54b6688bea75a4a9ecbcc
msgid "Run Mock Demo"
msgstr "运行模拟演示"

#: ../../source/2-how_to/1-run_mock_demo.md:3 7b4c5bced7fd4e11842ea0a843c48718
msgid ""
"Run a robot demonstration in mock hardware mode without physical hardware"
" or simulation."
msgstr "在模拟硬件模式下运行机器人演示，无需实体硬件或仿真。"

#: ../../source/2-how_to/1-run_mock_demo.md:5 9b2352e119774b9bb0afaba1ad90375b
msgid "Prerequisites"
msgstr "前提条件"

#: ../../source/2-how_to/1-run_mock_demo.md:7 c7ec5967613542ee8f93ce092d83f80d
msgid "Workspace built and sourced"
msgstr "工作空间已编译并已执行 source"

#: ../../source/2-how_to/1-run_mock_demo.md:8 2f19ba2e238c489282b43aaa7c54eda0
msgid "RViz2 installed (`ros-jazzy-rviz2`)"
msgstr "已安装 RViz2（`ros-jazzy-rviz2`）"

#: ../../source/2-how_to/1-run_mock_demo.md:10 05579877b88843c39bd5b537d05e2cf5
msgid "Steps"
msgstr "步骤"

#: ../../source/2-how_to/1-run_mock_demo.md:12 9a942a262f034d569a54855b77c4fcbd
msgid "1. Source Workspace"
msgstr "1. 源 工作空间"

#: ../../source/2-how_to/1-run_mock_demo.md:14 f5f66157b2a64170b7f516f5ac4feaec
msgid ""
"source /opt/ros/jazzy/setup.bash\n"
"source ~/open-deploy-ws/install/setup.bash\n"
msgstr ""
"source /opt/ros/jazzy/setup.bash\n"
"source ~/open-deploy-ws/install/setup.bash\n"

#: ../../source/2-how_to/1-run_mock_demo.md:19 1a9c264771314e08ab2d790beab65e8f
msgid "2. Launch Mock Demo"
msgstr "2. 启动模拟演示"

#: ../../source/2-how_to/1-run_mock_demo.md:21 f91bd52d0d3c4898b714ca29384e2b86
msgid "ros2 launch ocs2_arm_controller demo.launch.py hardware:=mock\n"
msgstr "ros2 launch ocs2_arm_controller demo.launch.py hardware:=mock\n"

#: ../../source/2-how_to/1-run_mock_demo.md:25 49ce24b457774a438d91d594805f9ec9
msgid "3. Send Target Pose"
msgstr "3. 发送目标位姿"

#: ../../source/2-how_to/1-run_mock_demo.md:27 800f98a03ad44eae836337a996025a15
msgid "In a new terminal:"
msgstr "在新终端中："

#: ../../source/2-how_to/1-run_mock_demo.md:29 3c977e37994345488e080cad52f7b8e3
#, python-brace-format
msgid ""
"source ~/open-deploy-ws/install/setup.bash\n"
"ros2 topic pub /target_pose geometry_msgs/msg/PoseStamped \\\n"
"  \"{header: {frame_id: 'base_link'}, pose: {position: {x: 0.3, y: 0.1, "
"z: 0.4}, orientation: {w: 1.0}}}\" \\\n"
"  --once\n"
msgstr ""
"source ~/open-deploy-ws/install/setup.bash\n"
"ros2 topic pub /target_pose geometry_msgs/msg/PoseStamped \\\n"
"  \"{header: {frame_id: 'base_link'}, pose: {position: {x: 0.3, y: 0.1, "
"z: 0.4}, orientation: {w: 1.0}}}\" \\\n"
"  --once\n"

#: ../../source/2-how_to/1-run_mock_demo.md:36 1b4ca825083f40c2b990f75733d4ad7f
msgid "4. Observe Motion"
msgstr "4. 观察运动"

#: ../../source/2-how_to/1-run_mock_demo.md:38 0956de18f4214aeba6ae581b9599084c
msgid "Watch RViz — the robot should move to the target pose."
msgstr "观察 RViz — 机器人应移动到目标位姿。"

#: ../../source/2-how_to/1-run_mock_demo.md:40 b4316a727b834cd9a6209c0469b182ef
msgid "With Different Robots"
msgstr "使用不同机器人"

#: ../../source/2-how_to/1-run_mock_demo.md:42 d50752d41fa541cda03a7bd3da445ed7
msgid ""
"# Dobot CR5\n"
"ros2 launch ocs2_arm_controller demo.launch.py robot:=dobot_cr5 "
"hardware:=mock\n"
"\n"
"# Acone (arm only, not Lift 2S)\n"
"ros2 launch ocs2_arm_controller demo.launch.py robot:=arx_acone "
"hardware:=mock\n"
"\n"
"# HighTorque Panthera HT\n"
"ros2 launch ocs2_arm_controller demo.launch.py robot:=panthera_ht "
"hardware:=mock\n"
msgstr ""
"# Dobot CR5\n"
"ros2 launch ocs2_arm_controller demo.launch.py robot:=dobot_cr5 "
"hardware:=mock\n"
"\n"
"# Acone (arm only, not Lift 2S)\n"
"ros2 launch ocs2_arm_controller demo.launch.py robot:=arx_acone "
"hardware:=mock\n"
"\n"
"# HighTorque Panthera HT\n"
"ros2 launch ocs2_arm_controller demo.launch.py robot:=panthera_ht "
"hardware:=mock\n"

#: ../../source/2-how_to/1-run_mock_demo.md:53 3ecaadb1cef046d297a7fdc70c337c28
msgid "End-effector (`type`)"
msgstr "末端执行器（`type`）"

#: ../../source/2-how_to/1-run_mock_demo.md:55 71ba5470d8e649289222fb4445488bb4
#, fuzzy
msgid ""
"Not `gripper:=`. This launch includes "
"`create_robot_profile_launch_arguments()`. Symmetric EEF: `type:=`. "
"Different L/R: `left_type:=` and `right_type:=` together (**do not pass "
"`type:=`** then). Profile `defaults.end_effectors` applies unless "
"`use_profile_eef:=false`. See [Switch Robot](2-switch_robot.md) and "
"[robot_common_launch](../4-reference/descriptions/2-common.md)."
msgstr ""
"不是 `gripper:=`。此 launch 包含 `create_robot_profile_launch_arguments()`。对称末端：`type:=`。左右不同：同时传 `left_type:=` 与 `right_type:=`（此时**不要再传 `type:=`**）。除非 `use_profile_eef:=false`，否则使用 profile 的 `defaults.end_effectors`。见 [切换机器人](2-switch_robot.md) 与 [robot_common_launch](../4-reference/descriptions/2-common.md)。"

#: ../../source/2-how_to/1-run_mock_demo.md:57 efd54dbe4ea14403be618983781d5054
#, fuzzy
msgid ""
"ros2 launch ocs2_arm_controller demo.launch.py \\\n"
"  robot:=<robot_name> \\\n"
"  use_profile_eef:=false \\\n"
"  left_type:=rg75 right_type:=linkerhand_o7 \\\n"
"  hardware:=mock"
msgstr ""
"ros2 launch ocs2_arm_controller demo.launch.py \\\n"
"  robot:=<robot_name> \\\n"
"  use_profile_eef:=false \\\n"
"  left_type:=rg75 right_type:=linkerhand_o7 \\\n"
"  hardware:=mock"

