#: ../../source/2-how_to/1-run_mock_demo.md:1 3d06c69aac50481cbcebfbfc8df161e2
msgid "Run Mock Demo"
msgstr "运行模拟演示"

#: ../../source/2-how_to/1-run_mock_demo.md:3 12b429a18a04465f962ca0db9cc3ddb4
msgid ""
"Run a robot demonstration in mock hardware mode without physical hardware"
" or simulation."
msgstr "在模拟硬件模式下运行机器人演示，无需实体硬件或仿真。"

#: ../../source/2-how_to/1-run_mock_demo.md:5 fbf13e119563482a9293f61d5828dfa3
msgid "Prerequisites"
msgstr "前提条件"

#: ../../source/2-how_to/1-run_mock_demo.md:7 0327ad1390a14d3ea800517114a46371
msgid "Workspace built and sourced"
msgstr "工作空间已编译并已执行 source"

#: ../../source/2-how_to/1-run_mock_demo.md:8 5e711fdd01b24a0f9902ed0c4213e103
msgid "RViz2 installed (`ros-jazzy-rviz2`)"
msgstr "已安装 RViz2（`ros-jazzy-rviz2`）"

#: ../../source/2-how_to/1-run_mock_demo.md:10 e4878fc9207242d0aae4676aca51832b
msgid "Steps"
msgstr "步骤"

#: ../../source/2-how_to/1-run_mock_demo.md:12 48190a8e16924fb6962e2fa6a4a9d2ed
msgid "1. Source Workspace"
msgstr "1. 源 工作空间"

#: ../../source/2-how_to/1-run_mock_demo.md:14 464941a4300e44a4bbf948bb25b787cb
msgid ""
"source /opt/ros/jazzy/setup.bash\n"
"source ~/open-deploy-ws/install/setup.bash\n"
msgstr ""
"source /opt/ros/jazzy/setup.bash\n"
"source ~/open-deploy-ws/install/setup.bash\n"

#: ../../source/2-how_to/1-run_mock_demo.md:19 b79be382fd7a442896564336cbce8e06
msgid "2. Launch Mock Demo"
msgstr "2. 启动模拟演示"

#: ../../source/2-how_to/1-run_mock_demo.md:21 ca36c0c78cda4af4a1113aada9f3fc3d
msgid "ros2 launch ocs2_arm_controller demo.launch.py hardware:=mock\n"
msgstr ""
"ros2 launch ocs2_arm_controller demo.launch.py hardware:=mock\n"

#: ../../source/2-how_to/1-run_mock_demo.md:25 cdc2cd76c4ed4e4f8e94914111c10ae3
msgid "3. Send Target Pose"
msgstr "3. 发送目标位姿"

#: ../../source/2-how_to/1-run_mock_demo.md:27 bb73abd34b3c4d56ad85ce39625035ff
msgid "In a new terminal:"
msgstr "在新终端中："

#: ../../source/2-how_to/1-run_mock_demo.md:29 d7c915c0fd264ed090d85828bcc3b58e
#, python-brace-format
msgid ""
"source ~/open-deploy-ws/install/setup.bash\n"
"ros2 topic pub /target_pose geometry_msgs/msg/PoseStamped \\\n"
"  \"{header: {frame_id: 'base_link'}, pose: {position: {x: 0.3, y: 0.1, "
"z: 0.4}, orientation: {w: 1.0}}}\" \\\n"
"  --once\n"
msgstr ""
"source ~/open-deploy-ws/install/setup.bash\n"
"ros2 topic pub /target_pose geometry_msgs/msg/PoseStamped \\\n"
"  \"{header: {frame_id: 'base_link'}, pose: {position: {x: 0.3, y: 0.1, z: 0.4}, orientation: {w: 1.0}}}\" \\\n"
"  --once\n"

#: ../../source/2-how_to/1-run_mock_demo.md:36 413b1eff457243c0994ea28de9ae9145
msgid "4. Observe Motion"
msgstr "4. 观察运动"

#: ../../source/2-how_to/1-run_mock_demo.md:38 54e41b352aaa466c82dd20aed0c0f949
msgid "Watch RViz — the robot should move to the target pose."
msgstr "观察 RViz — 机器人应移动到目标位姿。"

#: ../../source/2-how_to/1-run_mock_demo.md:40 16981d1aa1684c39bab48068fcec1558
msgid "With Different Robots"
msgstr "使用不同机器人"

#: ../../source/2-how_to/1-run_mock_demo.md:42 16369f67ec9d4f33846a02d5cd06d46e
msgid ""
"# Dobot CR5\n"
"ros2 launch ocs2_arm_controller demo.launch.py robot:=dobot_cr5 "
"hardware:=mock\n"
"\n"
"# ARX ACone\n"
"ros2 launch ocs2_arm_controller demo.launch.py robot:=arx_acone "
"hardware:=mock\n"
msgstr ""
"# Dobot CR5\n"
"ros2 launch ocs2_arm_controller demo.launch.py robot:=dobot_cr5 hardware:=mock\n"
"\n"
"# ARX ACone\n"
"ros2 launch ocs2_arm_controller demo.launch.py robot:=arx_acone hardware:=mock\n"

#: ../../source/2-how_to/1-run_mock_demo.md:50 5a4959fff93446bea4a306d3bf4bde5a
msgid "With Gripper"
msgstr "带夹爪"

#: ../../source/2-how_to/1-run_mock_demo.md:52 1779b016b3c443cda32e16208a97f1da
msgid "TODO"
msgstr "待完成"

#: ../../source/2-how_to/1-run_mock_demo.md:55 6147199f136e4b7180712f4dd41f74b6
msgid ""
"For valid robot + gripper combinations, check the launch files in "
"`arms_ros2_control`."
msgstr "有效的机器人与夹爪组合，请查看 `arms_ros2_control` 中的启动文件。"

#: ../../source/2-how_to/1-run_mock_demo.md:58 16369f67ec9d4f33846a02d5cd06d46e
msgid ""
"# General pattern\n"
"ros2 launch ocs2_arm_controller demo.launch.py robot:=<robot_name> "
"gripper:=<gripper_name> hardware:=mock\n"
msgstr ""
"# General pattern\n"
"ros2 launch ocs2_arm_controller demo.launch.py robot:=<robot_name> gripper:=<gripper_name> hardware:=mock\n"

