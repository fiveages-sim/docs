#: ../../source/2-how_to/1-run_mock_demo.md:1 5688f3633f204845a4ca972ad610cc05
msgid "Run Mock Demo"
msgstr "运行模拟演示"

#: ../../source/2-how_to/1-run_mock_demo.md:3 64b36f6c8f3f4b4cae3dc0e286602b67
msgid ""
"Run a robot demonstration in mock hardware mode without physical hardware"
" or simulation."
msgstr "Run a robot demonstration in mock hardware mode without physical hardware or simulation."

#: ../../source/2-how_to/1-run_mock_demo.md:5 b921f3443a844e46a13e42366568d34a
msgid "Prerequisites"
msgstr "前提条件"

#: ../../source/2-how_to/1-run_mock_demo.md:7 bc11de57d5854f449f262e52a7e93469
msgid "Workspace built and sourced"
msgstr "工作空间 built and sourced"

#: ../../source/2-how_to/1-run_mock_demo.md:8 09e1b7e5f8bc4bb4bf03e269ad4e0454
msgid "RViz2 installed (`ros-jazzy-rviz2`)"
msgstr "RViz2 installed (`ros-jazzy-rviz2`)"

#: ../../source/2-how_to/1-run_mock_demo.md:10 373437c505fe49eba1fd1c0a8b146919
msgid "Steps"
msgstr "步骤"

#: ../../source/2-how_to/1-run_mock_demo.md:12 478679b070984abf9aee767c9fddff41
msgid "1. Source Workspace"
msgstr "1. 源 工作空间"

#: ../../source/2-how_to/1-run_mock_demo.md:14 732a45cc13be4a5ab328614063aafcdb
msgid ""
"source /opt/ros/jazzy/setup.bash\n"
"source ~/open-deploy-ws/install/setup.bash\n"
msgstr ""
"source /opt/ros/jazzy/setup.bash\\n"
"source ~/open-deploy-ws/install/setup.bash\\n"

#: ../../source/2-how_to/1-run_mock_demo.md:19 12adcb9844c9499a8aa40bebe13bccfd
msgid "2. Launch Mock Demo"
msgstr "2. Launch Mock Demo"

#: ../../source/2-how_to/1-run_mock_demo.md:21 4f200bbd14f3499d905edc960eac385e
msgid "ros2 launch ocs2_arm_controller demo.launch.py hardware:=mock\n"
msgstr "ros2 launch ocs2_arm_controller demo.launch.py hardware:=mock\\n"

#: ../../source/2-how_to/1-run_mock_demo.md:25 ccd50d4eaf674192a42fa80bc5f7ce40
msgid "3. Send Target Pose"
msgstr "3. Send 目标 Pose"

#: ../../source/2-how_to/1-run_mock_demo.md:27 e46b0edc546a4a9bb3975f5f4fc9b6ff
msgid "In a new terminal:"
msgstr "In a new terminal:"

#: ../../source/2-how_to/1-run_mock_demo.md:29 4b0b0559019f472da4b17fa0fc293b4d
#, python-brace-format
msgid ""
"source ~/open-deploy-ws/install/setup.bash\n"
"ros2 topic pub /target_pose geometry_msgs/msg/PoseStamped \\\n"
"  \"{header: {frame_id: 'base_link'}, pose: {position: {x: 0.3, y: 0.1, "
"z: 0.4}, orientation: {w: 1.0}}}\" \\\n"
"  --once\n"
msgstr ""
"source ~/open-deploy-ws/install/setup.bash\\n"
"ros2 topic pub /target_pose geometry_msgs/msg/PoseStamped \\\\\\n"
"  \\\"{header: {frame_id: 'base_link'}, pose: {position: {x: 0.3, y: 0.1, z: 0.4}, orientation: {w: 1.0}}}\\\" \\\\\\n"
"  --once\\n"

#: ../../source/2-how_to/1-run_mock_demo.md:36 6a5492ac36ff4036a6d696d523314502
msgid "4. Observe Motion"
msgstr "4. Observe Motion"

#: ../../source/2-how_to/1-run_mock_demo.md:38 4c81c6a9465d485ca83c71da758c61d7
msgid "Watch RViz — the robot should move to the target pose."
msgstr "Watch RViz — the robot should move to the target pose."

#: ../../source/2-how_to/1-run_mock_demo.md:40 21266abc471747b7b445d4891313d21d
msgid "With Different Robots"
msgstr "With Different 机器人"

#: ../../source/2-how_to/1-run_mock_demo.md:42 1a759be191194582ab24115a10db4f30
msgid ""
"# Dobot CR5\n"
"ros2 launch ocs2_arm_controller demo.launch.py robot:=dobot_cr5 "
"hardware:=mock\n"
"\n"
"# ARX ACone\n"
"ros2 launch ocs2_arm_controller demo.launch.py robot:=arx_acone "
"hardware:=mock\n"
"\n"
"# With gripper\n"
"ros2 launch ocs2_arm_controller demo.launch.py robot:=dobot_cr5 "
"gripper:=dh_ag95 hardware:=mock\n"
msgstr ""
"# Dobot CR5\\n"
"ros2 launch ocs2_arm_controller demo.launch.py robot:=dobot_cr5 hardware:=mock\\n"
"\\n"
"# ARX ACone\\n"
"ros2 launch ocs2_arm_controller demo.launch.py robot:=arx_acone hardware:=mock\\n"
"\\n"
"# With gripper\\n"
"ros2 launch ocs2_arm_controller demo.launch.py robot:=dobot_cr5 gripper:=dh_ag95 hardware:=mock\\n"

