msgid ""
"In a new terminal, from fa-py-libraries (README commands — there is no "
"`./run.sh vr --mode`):"
msgstr "在新终端中，于 fa-py-libraries 内执行（README 命令 — 没有 `./run.sh vr --mode`）："

#: ../../source/2-how_to/6-vr_teleop.md:53 7a714ad8224e482a9ff8bec9d90f9e22
msgid ""
"cd ~/fa-py-libraries\n"
"./run.sh vr"
msgstr ""
"cd ~/fa-py-libraries\n"
"./run.sh vr"

