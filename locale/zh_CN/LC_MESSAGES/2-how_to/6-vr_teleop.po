msgstr "设置"

#: ../../source/2-how_to/6-vr_teleop.md:31 45fa7ffd3f2947329a1ba1416a978176
msgid "1. Install fa-py-libraries"
msgstr "1. 安装 fa-py-libraries"

#: ../../source/2-how_to/6-vr_teleop.md:33 85afa385f9394399803862309ee6a398
msgid ""
"cd ~/\n"
"git clone https://github.com/fiveages-sim/fa-py-libraries.git\n"
"cd fa-py-libraries\n"
"./init.sh all"
msgstr ""
"cd ~/\n"
"git clone https://github.com/fiveages-sim/fa-py-libraries.git\n"
"cd fa-py-libraries\n"
"./init.sh all"

#: ../../source/2-how_to/6-vr_teleop.md:40 6780043eca434e6c94b2d0faa8108f77
msgid ""
"What `./init.sh all` does: submodules + Python 3.12 env + "
"`ros2_robot_interface` / `ros2-viser` / `vr_pose_publisher`."
msgstr ""
"`./init.sh all` 做什么：子模块 + Python 3.12 环境 + `ros2_robot_interface` / "
"`ros2-viser` / `vr_pose_publisher`。"

#: ../../source/2-how_to/6-vr_teleop.md:42 d2966f304a2b4ec1ac803e57366b888a
msgid "2. Start Robot Demo"
msgstr "2. 启动机器人演示"

#: ../../source/2-how_to/6-vr_teleop.md:44 4fb8283f73a64fe5a4e62a9c8f42cf47
msgid ""
"source ~/open-deploy-ws/install/setup.bash\n"
"ros2 launch ocs2_arm_controller demo.launch.py hardware:=mock\n"
msgstr ""
"source ~/open-deploy-ws/install/setup.bash\n"
"ros2 launch ocs2_arm_controller demo.launch.py hardware:=mock\n"

#: ../../source/2-how_to/6-vr_teleop.md:49 5a2cfaa89ca5447583f67b26a3910409
msgid "3. Start VR Bridge"
msgstr "3. 启动 VR 桥接"

