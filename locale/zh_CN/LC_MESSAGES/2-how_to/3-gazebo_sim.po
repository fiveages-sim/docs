#: ../../source/2-how_to/3-gazebo_sim.md:108 d70b24cf4bfb4a8fb1d3fdf9a010786e
msgid ""
"# Check GPU drivers\n"
"nvidia-smi\n"
"\n"
"# Try software rendering\n"
"export LIBGL_ALWAYS_SOFTWARE=1\n"
"ros2 launch ocs2_arm_controller demo.launch.py hardware:=gz\n"
msgstr ""
"# Check GPU drivers\n"
"nvidia-smi\n"
"\n"
"# Try software rendering\n"
