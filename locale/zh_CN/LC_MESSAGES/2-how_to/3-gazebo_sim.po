#: ../../source/2-how_to/3-gazebo_sim.md:1 98d8b708a83c47a6b1026d2bbdc904e8
msgid "Gazebo Simulation"
msgstr "Gazebo 仿真"

#: ../../source/2-how_to/3-gazebo_sim.md:3 e7c4630ceea54adfacae2b3d2526112f
msgid "Run robot demos with Gazebo Harmonic physics simulation."
msgstr "使用 Gazebo Harmonic 物理仿真运行机器人演示。"

#: ../../source/2-how_to/3-gazebo_sim.md:5 0d5b601883084b65a0cacb7dcaf39714
msgid "Prerequisites"
msgstr "前提条件"

#: ../../source/2-how_to/3-gazebo_sim.md:7 4243267ab6234eaa85d0bb337c70e97e
msgid "Workspace built"
msgstr "工作空间已编译"

#: ../../source/2-how_to/3-gazebo_sim.md:8 4e310e0389d24e69897855917b983a9a
msgid "Gazebo Harmonic packages installed"
msgstr "已安装 Gazebo Harmonic 相关软件包"

#: ../../source/2-how_to/3-gazebo_sim.md:10 500a9645baf14dbb988073dd4352a1ea
msgid "Install Gazebo"
msgstr "安装 Gazebo"

#: ../../source/2-how_to/3-gazebo_sim.md:12 67dbe4d1845543d4b1f99611c85cc84f
msgid "sudo apt install ros-jazzy-gz-*\n"
msgstr "sudo apt install ros-jazzy-gz-*\n"

#: ../../source/2-how_to/3-gazebo_sim.md:16 fbc76950c49e4ba3848669fe05242fed
msgid "Steps"
msgstr "步骤"

#: ../../source/2-how_to/3-gazebo_sim.md:18 8e0ff4c47e874a329b95d06215794eb8
msgid "1. Source Workspace"
msgstr "1. 源 工作空间"

#: ../../source/2-how_to/3-gazebo_sim.md:20 35a86e6a832e4f169c18b8e5c80ed37d
msgid ""
"source /opt/ros/jazzy/setup.bash\n"
"source ~/open-deploy-ws/install/setup.bash\n"
msgstr ""
"source /opt/ros/jazzy/setup.bash\n"
"source ~/open-deploy-ws/install/setup.bash\n"

#: ../../source/2-how_to/3-gazebo_sim.md:25 2563c398c7354049964240d4eb950b08
msgid "2. Launch with Gazebo"
msgstr "2. 使用 Gazebo 启动"

#: ../../source/2-how_to/3-gazebo_sim.md:27 7ff3bd6c4b814825becb0768801cb40b
msgid "ros2 launch ocs2_arm_controller demo.launch.py hardware:=gz\n"
msgstr "ros2 launch ocs2_arm_controller demo.launch.py hardware:=gz\n"

#: ../../source/2-how_to/3-gazebo_sim.md:31 de4b5b3ddc224370a99532888284f33b
msgid "This launches:"
msgstr "这将启动："

#: ../../source/2-how_to/3-gazebo_sim.md:32 26670ee30317401e85862858cdd6a2cd
msgid "Gazebo simulator with robot model"
msgstr "带有机器人模型的 Gazebo 仿真器"

#: ../../source/2-how_to/3-gazebo_sim.md:33 9ceb66b8cdc046f8859ca39d993eb3af
msgid "ROS 2 controllers"
msgstr "ROS 2 控制器"

#: ../../source/2-how_to/3-gazebo_sim.md:34 674e2fc685ba4eeb8353917617350d67
msgid "RViz visualization"
msgstr "RViz 可视化"

#: ../../source/2-how_to/3-gazebo_sim.md:36 d271670eb4c443038620b31a069eb21e
msgid "3. Interact"
msgstr "3. 交互"

#: ../../source/2-how_to/3-gazebo_sim.md:38 c96daae3c0e7406e958bdc92b44f9275
msgid "Send commands as usual:"
msgstr "像往常一样发送指令："

#: ../../source/2-how_to/3-gazebo_sim.md:40 4aa89df87d8a41bb8faed5f12b519fa8
#, python-brace-format
msgid ""
"ros2 topic pub /target_pose geometry_msgs/msg/PoseStamped \\\n"
"  \"{header: {frame_id: 'base_link'}, pose: {position: {x: 0.3, y: 0.0, z: 0.4}, orientation: {w: 1.0}}}\" \\\n"
"  --once\n"
msgstr ""
"ros2 topic pub /target_pose geometry_msgs/msg/PoseStamped \\\n"
"  \"{header: {frame_id: 'base_link'}, pose: {position: {x: 0.3, y: 0.0, z: 0.4}, orientation: {w: 1.0}}}\" \\\n"
"  --once\n"

#: ../../source/2-how_to/3-gazebo_sim.md:46 5f56a4ecf5e84a518171f953d6b93fb9
msgid "Launch Options"
msgstr "启动选项"

#: ../../source/2-how_to/3-gazebo_sim.md:48 7fc07ae4e9a6476483fe7c1095c44daa
msgid ""
"# With specific robot\n"
"# Acone arm (not Lift 2s)\n"
"ros2 launch ocs2_arm_controller demo.launch.py robot:=arx_acone hardware:=gz\n"
"\n"
"# Without RViz (Gazebo only)\n"
"ros2 launch ocs2_arm_controller demo.launch.py hardware:=gz rviz:=false\n"
"\n"
"# Headless mode\n"
"ros2 launch ocs2_arm_controller demo.launch.py hardware:=gz headless:=true\n"
msgstr ""
"# With specific robot\n"
"# Acone arm (not Lift 2s)\n"
"ros2 launch ocs2_arm_controller demo.launch.py robot:=arx_acone hardware:=gz\n"
"\n"
"# Without RViz (Gazebo only)\n"
"ros2 launch ocs2_arm_controller demo.launch.py hardware:=gz rviz:=false\n"
"\n"
"# Headless mode\n"
"ros2 launch ocs2_arm_controller demo.launch.py hardware:=gz headless:=true\n"

#: ../../source/2-how_to/3-gazebo_sim.md:60 e7ddd32f42bc4bfc9e17c117634c4cf0
msgid "Gazebo Features"
msgstr "Gazebo 功能"

#: ../../source/2-how_to/3-gazebo_sim.md:62 0548fbdcd1e84aedabc534708dea37a9
msgid "Physics Tuning"
msgstr "物理调参"

#: ../../source/2-how_to/3-gazebo_sim.md:64 b03f2d8376f14fd1a958587808967af7
msgid ""
"The default physics parameters work for most robots. For custom tuning, "
"modify the SDF files in the description packages."
msgstr "默认物理参数适用于大多数机器人。如需自定义调参，请修改描述软件包中的 SDF 文件。"

#: ../../source/2-how_to/3-gazebo_sim.md:66 e8836dc3d56f415b9715b81a2b540c3e
msgid "World Files"
msgstr "世界文件"

#: ../../source/2-how_to/3-gazebo_sim.md:68 28fa266efbce4ff096b1a295be226cbb
msgid "Custom world files can be loaded:"
msgstr "可以加载自定义世界文件："

#: ../../source/2-how_to/3-gazebo_sim.md:70 ef0b6465d3e243ee952840f6c59b506f
msgid ""
"ros2 launch ocs2_arm_controller demo.launch.py hardware:=gz "
"world:=custom_world.sdf\n"
msgstr ""
"ros2 launch ocs2_arm_controller demo.launch.py hardware:=gz "
"world:=custom_world.sdf\n"

#: ../../source/2-how_to/3-gazebo_sim.md:74 3063d625def14dd7a0784793b8b062bc
msgid "Recording"
msgstr "录制"

#: ../../source/2-how_to/3-gazebo_sim.md:76 670614146b8a48b089888d2677402d29
msgid "Record simulation for playback:"
msgstr "录制仿真以便回放："

#: ../../source/2-how_to/3-gazebo_sim.md:78 c7c185e34a5a48d181beca72f3073520
msgid ""
"gz service -s /world/default/control \\\n"
"  --reqtype gz.msgs.WorldControl \\\n"
"  --reptype gz.msgs.Boolean \\\n"
"  --timeout 3000 \\\n"
"  --req 'pause: false'\n"
msgstr ""
"gz service -s /world/default/control \\\n"
"  --reqtype gz.msgs.WorldControl \\\n"
"  --reptype gz.msgs.Boolean \\\n"
"  --timeout 3000 \\\n"
"  --req 'pause: false'\n"

