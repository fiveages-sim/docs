msgstr ""

#: ../../source/2-how_to/2-switch_robot.md:74 d07910a0b7004711ad30c143a124d00c
msgid ""
"# Dobot with DH AG95\n"
"ros2 launch ocs2_arm_controller demo.launch.py robot:=dobot_cr5 "
"gripper:=dh_ag95 hardware:=mock\n"
"\n"
"# ARX with inspire hand\n"
"ros2 launch ocs2_arm_controller demo.launch.py robot:=arx_x5 "
"gripper:=inspire_rh56 hardware:=mock\n"
msgstr ""

