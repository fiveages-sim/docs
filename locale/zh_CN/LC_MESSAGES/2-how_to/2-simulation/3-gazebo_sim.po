#: 8781e2ae48184664bfcd1db3a8558b82
msgid ""
"# Acone (dual-arm, not Lift 2S)\n"
"ros2 launch ocs2_arm_controller demo.launch.py robot:=arx_acone "
"hardware:=gz\n"
msgstr ""
"# Acone (dual-arm, not Lift 2S)\n"
"ros2 launch ocs2_arm_controller demo.launch.py robot:=arx_acone "
