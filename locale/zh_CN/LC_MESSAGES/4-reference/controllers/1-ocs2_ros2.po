#: 4f17b2c9ea9941de8f0ac0e418770862
msgid "Usage"
msgstr "使用方法"

#: ../../source/4-reference/controllers/1-ocs2_ros2.md:40
#: ed7375fb463545519ceea2e9abfbbf5e
msgid ""
"OCS2 is typically used through higher-level controllers like "
"`ocs2_arm_controller`. Direct usage:"
msgstr "OCS2 通常通过更高层的控制器（如 `ocs2_arm_controller`）使用。直接使用方式："

#: ../../source/4-reference/controllers/1-ocs2_ros2.md:42
#: 33f9037eb55743e6810ff19d5b5d3d41
msgid "Include in Package"
msgstr "在软件包中引入"

#: ../../source/4-reference/controllers/1-ocs2_ros2.md:44
#: 6b9a02e823aa4a918f92593dde43c386
msgid ""
"find_package(ocs2_core REQUIRED)\n"
"find_package(ocs2_mpc REQUIRED)\n"
"find_package(ocs2_robotic_tools REQUIRED)\n"
"\n"
"target_link_libraries(my_controller\n"
"  ocs2_core::ocs2_core\n"
"  ocs2_mpc::ocs2_mpc\n"
")\n"
msgstr ""
"find_package(ocs2_core REQUIRED)\n"
"find_package(ocs2_mpc REQUIRED)\n"
"find_package(ocs2_robotic_tools REQUIRED)\n"
"\n"
"target_link_libraries(my_controller\n"
"  ocs2_core::ocs2_core\n"
"  ocs2_mpc::ocs2_mpc\n"
")\n"

