msgstr "Python 接口"

#: ../../source/4-reference/controllers/2-ocs2_arm_controller.md:116
#: ca66a23d500e44dda0431295ea3f0393
msgid ""
"from geometry_msgs.msg import PoseStamped\n"
"import rclpy\n"
"\n"
"rclpy.init()\n"
"node = rclpy.create_node('target_sender')\n"
"pub = node.create_publisher(PoseStamped, '/target_pose', 10)\n"
"\n"
"target = PoseStamped()\n"
"target.header.frame_id = 'base_link'\n"
"target.pose.position.x = 0.3\n"
"target.pose.position.y = 0.0\n"
"target.pose.position.z = 0.4\n"
"target.pose.orientation.w = 1.0\n"
"\n"
"pub.publish(target)\n"
msgstr ""
"from geometry_msgs.msg import PoseStamped\\nimport "
"rclpy\\n\\nrclpy.init()\\nnode = rclpy.create_node('target_sender')\\npub"
" = node.create_publisher(PoseStamped, '/target_pose', 10)\\n\\ntarget = "
"PoseStamped()\\ntarget.header.frame_id = "
"'base_link'\\ntarget.pose.position.x = 0.3\\ntarget.pose.position.y = "
"0.0\\ntarget.pose.position.z = 0.4\\ntarget.pose.orientation.w = "
"1.0\\n\\npub.publish(target)\\n"

