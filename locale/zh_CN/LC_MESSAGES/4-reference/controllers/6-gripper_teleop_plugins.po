"/gripper/command std_msgs/msg/Float64 \\\"{data: 0.0}\\\" --once\\n\\n# "
"Half open\\nros2 topic pub /gripper/command std_msgs/msg/Float64 "
"\\\"{data: 0.5}\\\" --once\\n"

