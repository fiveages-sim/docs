"    ├── fiveages_env/\n"
"    ├── fa-project-usd/             # private\n"
"    ├── artvip-usd/\n"
"    └── labutopia-usd/"
msgstr ""
"FaSim-Isaac/\n"
"├── init.sh\n"
"├── run.sh\n"
"├── run_headless.sh\n"
"├── config/                         # fa_sim.conf + optional "
