#: ../../source/4-reference/descriptions/2-common.md:44
#: d9c8640d0d744519983d1c358bd8050c
msgid ""
"<?xml version=\"1.0\"?>\n"
"<robot xmlns:xacro=\"http://www.ros.org/wiki/xacro\">\n"
"  \n"
"  <!-- Include gripper -->\n"
"  <xacro:include filename=\"$(find dh_ag95_description)/urdf/dh_ag95.urdf.xacro\"/>\n"
"  \n"
"  <!-- Attach to arm -->\n"
"  <xacro:dh_ag95 parent=\"arm_tool0\" prefix=\"gripper_\">\n"
"    <origin xyz=\"0 0 0\" rpy=\"0 0 0\"/>\n"
"  </xacro:dh_ag95>\n"
"  \n"
"</robot>\n"
msgstr ""
"<?xml version=\"1.0\"?>\n"
"<robot xmlns:xacro=\"http://www.ros.org/wiki/xacro\">\n"
"  \n"
"  <!-- Include gripper -->\n"
"  <xacro:include filename=\"$(find dh_ag95_description)/urdf/dh_ag95.urdf.xacro\"/>\n"
"  \n"
"  <!-- Attach to arm -->\n"
"  <xacro:dh_ag95 parent=\"arm_tool0\" prefix=\"gripper_\">\n"
"    <origin xyz=\"0 0 0\" rpy=\"0 0 0\"/>\n"
"  </xacro:dh_ag95>\n"
"  \n"
"</robot>\n"

