#: ../../source/4-reference/teleop/2-drag_teleop.md:9
#: b3d6c5f54d5e4160b95fc41e387339df
msgid "Purpose"
msgstr "用途"

#: ../../source/4-reference/teleop/2-drag_teleop.md:11
#: 89d8e0fd194847dcb5ad5a0f968234bd
msgid "One `ros2_control` controller plugin, started twice:"
msgstr "同一个 `ros2_control` 控制器插件，启动两次："

#: ../../source/4-reference/teleop/2-drag_teleop.md:13
#: 6f427ad238c44a49b68c30a87422932e
msgid ""
"`role:=master` — operator arm with Pinocchio gravity compensation (`τ_G = "
"rnea(q, 0, 0)`); optional force feedback"
msgstr "`role:=master` — 操作者臂，Pinocchio 重力补偿（`τ_G = rnea(q, 0, 0)`）；可选力反馈"

#: ../../source/4-reference/teleop/2-drag_teleop.md:14
#: aa771bb23df54a1b9e4375721a6633cb
msgid ""
"`role:=slave` — follower; tracks mapped master joints (`position` / `mit` / "
"`effort`)"
msgstr "`role:=slave` — 从臂；跟踪映射后的主臂关节（`position` / `mit` / `effort`）"

#: ../../source/4-reference/teleop/2-drag_teleop.md:16
#: 3e2cc58dabc845fe91530a54bbf7f62c
msgid ""
"Joint mapping (and effort mapping under power conservation) is applied "
"**before** publishing `teleop_states`. Arm joints (12) are commanded by this"
" controller; grippers use `adaptive_gripper_controller`."
msgstr ""
"关节映射（以及功率守恒下的力矩映射）在发布 `teleop_states` **之前**完成。12 个臂关节由本控制器命令；夹爪使用 "
"`adaptive_gripper_controller`。"

#: ../../source/4-reference/teleop/2-drag_teleop.md:18
#: 8dd200264c0044adb899cc4665510093
msgid ""
"There is **no** `enter_teach_mode`, `/start_recording`, or `/playback` "
"service."
msgstr "**没有** `enter_teach_mode`、`/start_recording` 或 `/playback` 服务。"

#: ../../source/4-reference/teleop/2-drag_teleop.md:20
#: 50f1d47176034fdab9803e75be26cfd8
msgid "Launch"
msgstr "启动文件"

#: ../../source/4-reference/teleop/2-drag_teleop.md:22
#: ddb9fe5aae87410fabc708b3344ea928
msgid ""
"Launch file: `drag_teleop_controller.launch.py` (not "
"`drag_teleop.launch.py`)."
msgstr "启动文件：`drag_teleop_controller.launch.py`（不是 `drag_teleop.launch.py`）。"

#: ../../source/4-reference/teleop/2-drag_teleop.md:24
#: 90224e71489c43b387278f005b8306c9
msgid ""
"# Mock\n"
"ros2 launch drag_teleop_controller drag_teleop_controller.launch.py \\\n"
"  role:=master hardware:=mock_components\n"
"ros2 launch drag_teleop_controller drag_teleop_controller.launch.py \\\n"
"  role:=slave hardware:=mock_components\n"
"\n"
"# Real (see README for mode × hardware interface requirements)\n"
"ros2 launch drag_teleop_controller drag_teleop_controller.launch.py \\\n"
"  role:=master hardware:=real mode:=effort \\\n"
"  hardware_control_mode:=effort\n"
"ros2 launch drag_teleop_controller drag_teleop_controller.launch.py \\\n"
"  role:=slave hardware:=real mode:=mit\n"
msgstr ""
"# Mock\n"
"ros2 launch drag_teleop_controller drag_teleop_controller.launch.py \\\n"
"  role:=master hardware:=mock_components\n"
"ros2 launch drag_teleop_controller drag_teleop_controller.launch.py \\\n"
"  role:=slave hardware:=mock_components\n"
"\n"
"# Real (see README for mode × hardware interface requirements)\n"
"ros2 launch drag_teleop_controller drag_teleop_controller.launch.py \\\n"
"  role:=master hardware:=real mode:=effort \\\n"
"  hardware_control_mode:=effort\n"
"ros2 launch drag_teleop_controller drag_teleop_controller.launch.py \\\n"
"  role:=slave hardware:=real mode:=mit\n"

