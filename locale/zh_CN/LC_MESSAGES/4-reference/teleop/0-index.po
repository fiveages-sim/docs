#: ../../source/4-reference/teleop/0-index.md 672b63f5837d44429628e872b160c1bf
msgid ""
"Arm velocity via `control_input` → twist; chassis `/cmd_vel` in chassis "
"mode"
msgstr "通过 `control_input` → twist 控制手臂速度；底盘模式下发 `/cmd_vel`"

#: ../../source/4-reference/teleop/0-index.md ecf385e00d1d4161a0fadda95d84716b
msgid "Isomorphic"
msgstr "同构"

