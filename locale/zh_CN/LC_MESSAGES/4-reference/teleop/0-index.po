msgid "Input"
msgstr "输入"

#: ../../source/4-reference/teleop/0-index.md b67fcc0fb17340fbaa1f37138ead2885
msgid "Role"
msgstr "职责"

#: ../../source/4-reference/teleop/0-index.md fb53922c8a8f46a89a6b523c0dd1339a
msgid "VR"
