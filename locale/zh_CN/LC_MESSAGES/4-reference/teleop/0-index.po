msgstr "主从（高擎 Panthera HT）"

#: ../../source/4-reference/teleop/0-index.md a51752290ad9430f9860bd2796a0763c
msgid "Joint-space following"
msgstr "关节空间跟随"

#: ../../source/4-reference/teleop/0-index.md 8507b6e5257144fea4ac512e04643f74
