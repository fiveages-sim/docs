msgstr "手套，可选配 Vive Tracker"

#: ../../source/4-reference/teleop/0-index.md 09694b52c9e14d7ab065ceb5640e5f2b
msgid "Finger / hand joints; optional arm pose from Vive Tracker"
msgstr "手指 / 手部关节；可选由 Vive Tracker 提供手臂位姿"

#: ../../source/4-reference/teleop/0-index.md 218ed12b22964d669a5e3c8829a5f687
