msgstr "将 VR 追踪数据桥接到 ROS 2 话题："

#: ../../source/4-reference/teleop/1-vr_pose_publisher.md:33
#: ed516817a6884211aa62d0eb17763e5c
msgid "Head tracking"
msgstr "头部追踪"

