msgstr "XRoboToolkit 模式"

#: ../../source/4-reference/teleop/1-vr_pose_publisher.md:46
#: bb91b5dc09c2438486ef3abb7396948e
msgid "Native application — lower latency, recommended for production:"
msgstr "原生应用——延迟更低，建议用于生产环境："

#: ../../source/4-reference/teleop/1-vr_pose_publisher.md:48
#: e6560634f6ab42288956634290e038a4
msgid ""
"./init.sh install-xrobotoolkit-pc-service\n"
"./init.sh install-xrobotoolkit\n"
"./run.sh vr-xrt-service\n"
"./run.sh vr-xrt"
msgstr ""
"./init.sh install-xrobotoolkit-pc-service\n"
"./init.sh install-xrobotoolkit\n"
"./run.sh vr-xrt-service\n"
"./run.sh vr-xrt"

#: ../../source/4-reference/teleop/1-vr_pose_publisher.md:55
#: 2aa8df785ad24826900a35ce162e3238
msgid ""
"Requires the XRoboToolkit app on the VR device. `./run.sh vr-xrt-service "
"stop` shuts down the PC Service."
msgstr ""
"需要在 VR 设备上安装 XRoboToolkit 应用。`./run.sh vr-xrt-service stop` 关闭 PC Service。"

