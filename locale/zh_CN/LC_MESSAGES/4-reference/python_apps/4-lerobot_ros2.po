#: ../../source/4-reference/python_apps/4-lerobot_ros2.md:28
#: 50577bce0b614b1d8f33cd624d1444b6
msgid ""
"Clone with submodules, then use `init.sh`. Do **not** treat `pip install "
"-e .` at the repo root as the install path."
msgstr "先带 submodule 克隆，再用 `init.sh`。**不要**把仓库根目录的 `pip install -e .` 当作安装路径。"

#: ../../source/4-reference/python_apps/4-lerobot_ros2.md:30
#: 9b68e694b3934390a3ccd24c4c55a94e
msgid ""
"git clone --recursive git@github.com:fiveages-sim/lerobot_ros2.git\n"
"cd lerobot_ros2\n"
"\n"
"# uv if needed: curl -LsSf https://astral.sh/uv/install.sh | sh\n"
"\n"
"./init.sh all\n"
"# motion / task queue only (no LeRobot):  ./init.sh all-motion\n"
"# recording / inference plugins:          ./init.sh install-lerobot\n"
"source .venv/bin/activate   # default backend=uv"
msgstr ""
"git clone --recursive git@github.com:fiveages-sim/lerobot_ros2.git\n"
"cd lerobot_ros2\n"
"\n"
"# uv if needed: curl -LsSf https://astral.sh/uv/install.sh | sh\n"
"\n"
"./init.sh all\n"
"# motion / task queue only (no LeRobot):  ./init.sh all-motion\n"
"# recording / inference plugins:          ./init.sh install-lerobot\n"
"source .venv/bin/activate   # default backend=uv"

