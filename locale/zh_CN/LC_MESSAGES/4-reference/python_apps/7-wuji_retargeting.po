#: 51f2594d02cf42fd8ac3c15b21b5209e
msgid ""
"retargeting:\n"
"  source:\n"
"    model: human_hand\n"
"    joint_names: [...]\n"
"  \n"
"  target:\n"
"    model: wuji_hand2\n"
"    joint_names: [...]\n"
"  \n"
"  mapping:\n"
"    # Joint correspondence\n"
"    human_thumb_mcp: wuji_thumb_1\n"
"    human_thumb_pip: wuji_thumb_2\n"
"    # ...\n"
msgstr ""
"retargeting:\\n"
"  source:\\n"
"    model: human_hand\\n"
"    joint_names: [...]\\n"
