#: ../../source/4-reference/python_apps/7-wuji_retargeting.md:22
#: bfe900cc89aa4584ac6a66720db81fb0
msgid "Usage"
msgstr "使用方法"

#: ../../source/4-reference/python_apps/7-wuji_retargeting.md:24
#: c4dbf81c95eb40de837c6d5e6d7159a4
msgid ""
"from wuji_retargeting import Retargeter\n"
"\n"
"retargeter = Retargeter(\n"
"    source_model=\"human_hand\",\n"
"    target_model=\"wuji_hand2\"\n"
")\n"
"\n"
"robot_joints = retargeter.retarget(human_joints)\n"
msgstr ""
"from wuji_retargeting import Retargeter\\n"
"\\n"
"retargeter = Retargeter(\\n"
"    source_model=\\\"human_hand\\\",\\n"
"    target_model=\\\"wuji_hand2\\\"\\n"
")\\n"
"\\n"
"robot_joints = retargeter.retarget(human_joints)\\n"

