#: ../../source/_vendored/ros2_robot_interface/README.md:32
#: 8c2c1b3ab4c740f8ad1d9c0aa7eab8cd
#, python-brace-format
msgid ""
"from ros2_robot_interface import ROS2RobotInterface, "
"ROS2RobotInterfaceConfig\n"
"from geometry_msgs.msg import Pose\n"
"\n"
"# Create configuration\n"
"config = ROS2RobotInterfaceConfig(\n"
"    joint_states_topic=\"/joint_states\",\n"
"    end_effector_pose_topic=\"/left_current_pose\",\n"
"    end_effector_target_topic=\"/left_target\",\n"
"    joint_names=[\"joint1\", \"joint2\", \"joint3\", \"joint4\", "
"\"joint5\", \"joint6\"]\n"
")\n"
"\n"
"# Create and connect interface\n"
"interface = ROS2RobotInterface(config)\n"
"interface.connect()\n"
"\n"
"# Get joint state\n"
"joint_state = interface.get_joint_state()\n"
"if joint_state:\n"
"    print(f\"Joint positions: {joint_state['positions']}\")\n"
"\n"
"# Get end-effector pose (returns None if not connected)\n"
"pose = interface.left_arm_handler.get_pose()\n"
"if pose:\n"
"    print(f\"End-effector position: ({pose.position.x}, "
"{pose.position.y}, {pose.position.z})\")\n"
"else:\n"
"    print(\"Interface not connected or pose not available\")\n"
"\n"
"# Send target pose\n"
"target_pose = Pose()\n"
"target_pose.position.x = 0.5\n"
"target_pose.position.y = 0.0\n"
"target_pose.position.z = 0.3\n"
"target_pose.orientation.w = 1.0\n"
"interface.left_arm_handler.send_target(target_pose)\n"
"\n"
"# Control gripper\n"
"interface.left_gripper_handler.send_joint_positions(0.5)  # 行程/开度目标值为 "
"0.5（非“50%百分比”语义）\n"
"\n"
"# Disconnect\n"
"interface.disconnect()\n"
msgstr ""
"from ros2_robot_interface import ROS2RobotInterface, "
"ROS2RobotInterfaceConfig\n"
"from geometry_msgs.msg import Pose\n"
"\n"
"# Create configuration\n"
"config = ROS2RobotInterfaceConfig(\n"
"    joint_states_topic=\"/joint_states\",\n"
"    end_effector_pose_topic=\"/left_current_pose\",\n"
"    end_effector_target_topic=\"/left_target\",\n"
"    joint_names=[\"joint1\", \"joint2\", \"joint3\", \"joint4\", "
"\"joint5\", \"joint6\"]\n"
")\n"
"\n"
"# Create and connect interface\n"
"interface = ROS2RobotInterface(config)\n"
"interface.connect()\n"
"\n"
"# Get joint state\n"
"joint_state = interface.get_joint_state()\n"
"if joint_state:\n"
"    print(f\"Joint positions: {joint_state['positions']}\")\n"
"\n"
"# Get end-effector pose (returns None if not connected)\n"
"pose = interface.left_arm_handler.get_pose()\n"
"if pose:\n"
"    print(f\"End-effector position: ({pose.position.x}, "
"{pose.position.y}, {pose.position.z})\")\n"
"else:\n"
"    print(\"Interface not connected or pose not available\")\n"
"\n"
"# Send target pose\n"
"target_pose = Pose()\n"
"target_pose.position.x = 0.5\n"
"target_pose.position.y = 0.0\n"
"target_pose.position.z = 0.3\n"
"target_pose.orientation.w = 1.0\n"
"interface.left_arm_handler.send_target(target_pose)\n"
