#: ../../source/4-reference/python_apps/1-ros2_robot_interface.md:109
#: 2982fe9a696a42c18a2cd645bb2e2de2
msgid "Async Interface"
msgstr "异步接口"

#: ../../source/4-reference/python_apps/1-ros2_robot_interface.md:111
#: 672f9c83ed4a415f9966e4ab510ca8df
msgid ""
"from ros2_robot_interface import AsyncRobotInterface\n"
"import asyncio\n"
"\n"
"async def main():\n"
"    robot = AsyncRobotInterface()\n"
"    await robot.connect()\n"
"    await robot.move_j_async([0.0, -0.5, 0.5, 0.0, 0.5, 0.0])\n"
"\n"
"asyncio.run(main())\n"
msgstr ""
"from ros2_robot_interface import AsyncRobotInterface\n"
"import asyncio\n"
"\n"
"async def main():\n"
"    robot = AsyncRobotInterface()\n"
"    await robot.connect()\n"
"    await robot.move_j_async([0.0, -0.5, 0.5, 0.0, 0.5, 0.0])\n"
"\n"
"asyncio.run(main())\n"

