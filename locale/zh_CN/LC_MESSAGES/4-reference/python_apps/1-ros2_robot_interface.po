#: ../../source/4-reference/python_apps/1-ros2_robot_interface.md:92
#: e62c4b516d314df19401e40d056966fe
msgid "Gripper"
msgstr "夹爪"

#: ../../source/4-reference/python_apps/1-ros2_robot_interface.md:94
#: 700ddf62b0794c058d088f085f4e2b87
msgid ""
"robot.gripper_open()\n"
"robot.gripper_close()\n"
"robot.gripper_move(position: float)  # 0.0-1.0\n"
"robot.get_gripper_position()  # -> float\n"
