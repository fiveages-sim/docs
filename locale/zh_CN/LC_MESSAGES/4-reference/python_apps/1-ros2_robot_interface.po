#: ../../source/4-reference/python_apps/1-ros2_robot_interface.md:29
#: aa56c1c6ae18498dadb45153d2145540
msgid "Quick Start"
msgstr ""

#: ../../source/4-reference/python_apps/1-ros2_robot_interface.md:31
#: aabbec321bda413c9e79bc2ab010774f
msgid ""
"from ros2_robot_interface import RobotInterface\n"
"\n"
"robot = RobotInterface()\n"
"robot.connect()\n"
"\n"
"# Move joints\n"
"robot.move_j([0.0, -0.5, 0.5, 0.0, 0.5, 0.0])\n"
"\n"
"# Move Cartesian\n"
"robot.move_l([0.3, 0.0, 0.4], [1.0, 0.0, 0.0, 0.0])\n"
"\n"
"# Gripper\n"
"robot.gripper_open()\n"
"robot.gripper_close()\n"
msgstr ""

#: ../../source/4-reference/python_apps/1-ros2_robot_interface.md:48
#: f3ab2aa04dbb4a5993525a93af9f20ac
msgid "API Reference"
msgstr "API 参考手册"

#: ../../source/4-reference/python_apps/1-ros2_robot_interface.md:50
#: e97c9b9332b74d839ea630376f8f331f
msgid "Connection"
msgstr ""

#: ../../source/4-reference/python_apps/1-ros2_robot_interface.md:52
#: 9c919815ec144f8fbaf96b3704acb8ae
msgid ""
"robot = RobotInterface()\n"
"robot.connect()\n"
"robot.disconnect()\n"
"robot.is_connected()  # -> bool\n"
msgstr ""

#: ../../source/4-reference/python_apps/1-ros2_robot_interface.md:59
#: 3c7b821d8617448e976cbf9881bd82a8
msgid "Motion"
msgstr "运动"

#: ../../source/4-reference/python_apps/1-ros2_robot_interface.md:61
#: b458c4166fc04d58a9436189784fa164
msgid ""
"# Joint space\n"
"robot.move_j(positions: List[float], duration: float = None)\n"
"\n"
"# Cartesian\n"
"robot.move_l(\n"
"    position: List[float],  # [x, y, z]\n"
"    orientation: List[float],  # [qw, qx, qy, qz]\n"
"    duration: float = None\n"
")\n"
"\n"
"# Check motion state\n"
"robot.is_moving()  # -> bool\n"
"robot.wait_for_motion()\n"
msgstr ""

#: ../../source/4-reference/python_apps/1-ros2_robot_interface.md:77
#: 5b83d8a605ab4fa8b25c1b74c65fa61b
msgid "State"
msgstr ""

#: ../../source/4-reference/python_apps/1-ros2_robot_interface.md:79
#: d1a3c18ece0442419f3afd8f6a05d3e7
msgid ""
"# Joint state\n"
"robot.get_joint_positions()  # -> List[float]\n"
"robot.get_joint_velocities()  # -> List[float]\n"
"\n"
"# Cartesian\n"
"robot.get_ee_pose()  # -> Pose\n"
msgstr ""

#: ../../source/4-reference/python_apps/1-ros2_robot_interface.md:88
#: 287bfb5d8e8442d98b769dd972330af0
msgid "Gripper"
msgstr "夹爪"

#: ../../source/4-reference/python_apps/1-ros2_robot_interface.md:90
#: d1e9f3e6016e4f3685d04b0f59a53e78
msgid ""
"robot.gripper_open()\n"
"robot.gripper_close()\n"
"robot.gripper_move(position: float)  # 0.0-1.0\n"
"robot.get_gripper_position()  # -> float\n"
msgstr ""

#: ../../source/4-reference/python_apps/1-ros2_robot_interface.md:97
#: 3c9d1092a9cd4b14b48c549a50491ee3
msgid "FSM"
msgstr ""

#: ../../source/4-reference/python_apps/1-ros2_robot_interface.md:99
#: f9f36aba9a5742e69521b19706ff2076
msgid ""
"robot.set_mode(mode: str)\n"
"robot.get_mode()  # -> str\n"
"robot.send_fsm_command(command: str)\n"
msgstr ""

#: ../../source/4-reference/python_apps/1-ros2_robot_interface.md:105
#: a2c04f8684f245db951ec7f3ed74431d
msgid "Async Interface"
msgstr "Async 接口"

#: ../../source/4-reference/python_apps/1-ros2_robot_interface.md:107
#: 115b661c2b1547d1ba0625713a1a38c9
msgid ""
"from ros2_robot_interface import AsyncRobotInterface\n"
"import asyncio\n"
"\n"
"async def main():\n"
"    robot = AsyncRobotInterface()\n"
"    await robot.connect()\n"
"    await robot.move_j_async([0.0, -0.5, 0.5, 0.0, 0.5, 0.0])\n"
"\n"
"asyncio.run(main())\n"
msgstr ""

