#: ../../source/4-reference/python_apps/1-ros2_robot_interface.md:56
#: 55e86839fe4e4d4ba2eeee58f75d4a90
msgid ""
"robot = RobotInterface()\n"
"robot.connect()\n"
"robot.disconnect()\n"
"robot.is_connected()  # -> bool\n"
msgstr ""
"robot = RobotInterface()\n"
"robot.connect()\n"
"robot.disconnect()\n"
"robot.is_connected()  # -> bool\n"

#: ../../source/4-reference/python_apps/1-ros2_robot_interface.md:63
#: 6b05750226734faebaa57cede7431853
msgid "Motion"
msgstr "运动"

#: ../../source/4-reference/python_apps/1-ros2_robot_interface.md:65
#: 98498611665b4792813592a3918d6c85
msgid ""
"# Joint space\n"
"robot.move_j(positions: List[float], duration: float = None)\n"
"\n"
"# Cartesian\n"
"robot.move_l(\n"
"    position: List[float],  # [x, y, z]\n"
"    orientation: List[float],  # [qw, qx, qy, qz]\n"
"    duration: float = None\n"
")\n"
"\n"
"# Check motion state\n"
"robot.is_moving()  # -> bool\n"
"robot.wait_for_motion()\n"
msgstr ""
"# Joint space\n"
"robot.move_j(positions: List[float], duration: float = None)\n"
"\n"
"# Cartesian\n"
"robot.move_l(\n"
"    position: List[float],  # [x, y, z]\n"
"    orientation: List[float],  # [qw, qx, qy, qz]\n"
"    duration: float = None\n"
")\n"
"\n"
"# Check motion state\n"
"robot.is_moving()  # -> bool\n"
"robot.wait_for_motion()\n"

#: ../../source/4-reference/python_apps/1-ros2_robot_interface.md:81
#: 99793c9093194a86a49e2bb41527ec5c
msgid "State"
msgstr "状态"

#: ../../source/4-reference/python_apps/1-ros2_robot_interface.md:83
#: 5166b464bb2c40da9128d0716ccc27da
msgid ""
"# Joint state\n"
"robot.get_joint_positions()  # -> List[float]\n"
"robot.get_joint_velocities()  # -> List[float]\n"
"\n"
"# Cartesian\n"
"robot.get_ee_pose()  # -> Pose\n"
msgstr ""
"# Joint state\n"
"robot.get_joint_positions()  # -> List[float]\n"
"robot.get_joint_velocities()  # -> List[float]\n"
"\n"
"# Cartesian\n"
"robot.get_ee_pose()  # -> Pose\n"

#: ../../source/4-reference/python_apps/1-ros2_robot_interface.md:92
#: d6b1ff0f28c04598839589eb1e5bb4f4
msgid "Gripper"
msgstr "夹爪"

#: ../../source/4-reference/python_apps/1-ros2_robot_interface.md:94
#: 60bf1147a385496dbcc73539b6fcabf0
msgid ""
"robot.gripper_open()\n"
"robot.gripper_close()\n"
"robot.gripper_move(position: float)  # 0.0-1.0\n"
"robot.get_gripper_position()  # -> float\n"
msgstr ""
"robot.gripper_open()\n"
"robot.gripper_close()\n"
"robot.gripper_move(position: float)  # 0.0-1.0\n"
"robot.get_gripper_position()  # -> float\n"

#: ../../source/4-reference/python_apps/1-ros2_robot_interface.md:101
#: b3a739e9d95643e9b524bda642982883
msgid "FSM"
msgstr "FSM"

#: ../../source/4-reference/python_apps/1-ros2_robot_interface.md:103
#: 2601591b3fb941dcb7ec94802dd6fcd4
msgid ""
"Controller FSM on `/fsm_command` is **`std_msgs/Int32`**. Do not send "
"invented strings such as `stand` / `walk`. See [FSM and "
"Topics](../../3-concepts/4-fsm_and_topics.md)."
msgstr ""
"`/fsm_command` 上的控制器 FSM 是 **`std_msgs/Int32`**。不要发送编造的 `stand` / `walk` "
"字符串。见 [FSM 与话题](../../3-concepts/4-fsm_and_topics.md)。"

#: ../../source/4-reference/python_apps/1-ros2_robot_interface.md:105
#: 72923bd8f33e49cd95146fad4473e9c5
msgid "Async Interface"
msgstr "异步接口"

#: ../../source/4-reference/python_apps/1-ros2_robot_interface.md:107
#: a2522e8b87f74ba78365815b21945349
msgid ""
"from ros2_robot_interface import AsyncRobotInterface\n"
"import asyncio\n"
"\n"
"async def main():\n"
"    robot = AsyncRobotInterface()\n"
"    await robot.connect()\n"
"    await robot.move_j_async([0.0, -0.5, 0.5, 0.0, 0.5, 0.0])\n"
"\n"
"asyncio.run(main())\n"
msgstr ""
"from ros2_robot_interface import AsyncRobotInterface\n"
"import asyncio\n"
"\n"
"async def main():\n"
"    robot = AsyncRobotInterface()\n"
"    await robot.connect()\n"
"    await robot.move_j_async([0.0, -0.5, 0.5, 0.0, 0.5, 0.0])\n"
"\n"
"asyncio.run(main())\n"

