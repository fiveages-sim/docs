#: ../../source/4-reference/python_apps/1-ros2_robot_interface.md:56
#: 1b31bec0e2584b3bab29c4ad4674f95c
msgid ""
"robot = RobotInterface()\n"
"robot.connect()\n"
"robot.disconnect()\n"
"robot.is_connected()  # -> bool\n"
