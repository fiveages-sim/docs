#: ../../source/4-reference/python_apps/1-ros2_robot_interface.md:63
#: bce024dc8a4148baa4720754991eec29
msgid "Motion"
msgstr "运动"

#: ../../source/4-reference/python_apps/1-ros2_robot_interface.md:65
#: 40ab8e72b4df442b8e9aeb155e7fd8c8
msgid ""
"# Joint space\n"
"robot.move_j(positions: List[float], duration: float = None)\n"
"\n"
"# Cartesian\n"
"robot.move_l(\n"
"    position: List[float],  # [x, y, z]\n"
"    orientation: List[float],  # [qw, qx, qy, qz]\n"
"    duration: float = None\n"
")\n"
"\n"
"# Check motion state\n"
"robot.is_moving()  # -> bool\n"
"robot.wait_for_motion()\n"
msgstr ""
"# Joint space\n"
"robot.move_j(positions: List[float], duration: float = None)\n"
"\n"
"# Cartesian\n"
"robot.move_l(\n"
"    position: List[float],  # [x, y, z]\n"
"    orientation: List[float],  # [qw, qx, qy, qz]\n"
"    duration: float = None\n"
")\n"
"\n"
"# Check motion state\n"
"robot.is_moving()  # -> bool\n"
"robot.wait_for_motion()\n"

#: ../../source/4-reference/python_apps/1-ros2_robot_interface.md:81
#: f619d83d6c354e91a913ef2d742f6305
msgid "State"
msgstr "状态"

#: ../../source/4-reference/python_apps/1-ros2_robot_interface.md:83
#: ff944a3c51564fdc914a3ce0364746ec
msgid ""
"# Joint state\n"
"robot.get_joint_positions()  # -> List[float]\n"
"robot.get_joint_velocities()  # -> List[float]\n"
"\n"
"# Cartesian\n"
"robot.get_ee_pose()  # -> Pose\n"
msgstr ""
"# Joint state\n"
"robot.get_joint_positions()  # -> List[float]\n"
"robot.get_joint_velocities()  # -> List[float]\n"
"\n"
"# Cartesian\n"
