#: ../../source/4-reference/python_apps/2-fa_py_libraries.md:17
#: 07635e53824c4909adb03f8a284cf638
msgid "Installation"
msgstr "安装"

#: ../../source/4-reference/python_apps/2-fa_py_libraries.md:19
#: ead4ee56479749f7a96b1c668d07902a
msgid ""
"git clone https://github.com/fiveages-sim/fa-py-libraries.git\n"
"cd fa-py-libraries\n"
"./init.sh all"
msgstr ""
"git clone https://github.com/fiveages-sim/fa-py-libraries.git\n"
