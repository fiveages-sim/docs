msgstr "`single_arm.pick`, `single_arm.place`, `single_arm.move_to_pose`, `single_arm.move_relative`, `single_arm.move_to_object`, `single_arm.goto_cache_pose`, `single_arm.drawer.pull_open`, `single_arm.drawer.close_push`"

