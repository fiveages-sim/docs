#: ../../source/4-reference/python_apps/5-robot_action_composer.md:27
#: f59e02715bb84d0b96542e7744dbaec1
msgid ""
"from robot_action_composer import ActionSequence, actions\n"
"\n"
"sequence = ActionSequence([\n"
"    actions.MoveJ([0, 0, 0, 0, 0, 0]),\n"
"    actions.MoveL([0.3, 0.0, 0.4]),\n"
"    actions.GripperClose(),\n"
"    actions.MoveL([0.3, 0.0, 0.5]),\n"
"    actions.MoveL([0.3, 0.2, 0.5]),\n"
"    actions.GripperOpen(),\n"
"])\n"
msgstr ""
"from robot_action_composer import ActionSequence, actions\\n"
"\\n"
"sequence = ActionSequence([\\n"
"    actions.MoveJ([0, 0, 0, 0, 0, 0]),\\n"
"    actions.MoveL([0.3, 0.0, 0.4]),\\n"
"    actions.GripperClose(),\\n"
"    actions.MoveL([0.3, 0.0, 0.5]),\\n"
"    actions.MoveL([0.3, 0.2, 0.5]),\\n"
"    actions.GripperOpen(),\\n"
"])\\n"

