#: ../../source/0-overview/0-index.md:5 fcb1b4faec284b33a895c08317743b21
msgid "What is FiveAges Sim?"
msgstr "什么是 FiveAges Sim？"

#: ../../source/0-overview/0-index.md:7 62536fdb559b4de6b8894e35418be5c8
msgid ""
"FiveAges Sim is a collection of ROS 2 packages and workspaces that enable:"
msgstr "FiveAges Sim 是一组 ROS 2 软件包与工作空间，可用于："

#: ../../source/0-overview/0-index.md:9 f7776049d6c1416b8bb98e70f4838645
msgid ""
"**Robot Description** — URDF/xacro models with ros2_control integration"
msgstr "**机器人描述** — 集成 ros2_control 的 URDF/xacro 模型"

#: ../../source/0-overview/0-index.md:10 a988215876ab42fdb9d432209676ae69
msgid "**Hardware Control** — Interface plugins for real robot hardware"
msgstr "**硬件控制** — 对接真实机器人硬件的接口插件"

#: ../../source/0-overview/0-index.md:11 14fa5d1ea267466da339c0434e4c34d6
msgid "**MPC Controllers** — OCS2-based motion planning and control"
msgstr "**MPC 控制器** — 基于 OCS2 的运动规划与控制"

#: ../../source/0-overview/0-index.md:12 681dbb10cdea4ddbaaf5c3388571c749
msgid "**Simulation** — Gazebo Harmonic and NVIDIA Isaac Sim backends"
