#: 5316e59af4ec471f8491192af1282c23
msgid ""
"git clone git@github.com:fiveages-sim/FaSim-Isaac.git\n"
"cd FaSim-Isaac\n"
"./init.sh\n"
msgstr ""
"git clone git@github.com:fiveages-sim/FaSim-Isaac.git\n"
"cd FaSim-Isaac\n"
"./init.sh\n"

