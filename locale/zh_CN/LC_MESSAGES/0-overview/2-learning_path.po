#: ../../source/0-overview/2-learning_path.md:134
#: dff8d4c026944f7784529d0290aa597d
msgid ""
"from ros2_robot_interface import RobotInterface\n"
"\n"
"robot = RobotInterface()\n"
"robot.connect()\n"
