#: 579d365fdfe34513918cd6be9e33c1c3
msgid ""
"ros2 launch ocs2_arm_controller demo.launch.py robot:=arx_acone "
"hardware:=mock\n"
msgstr ""
"ros2 launch ocs2_arm_controller demo.launch.py robot:=arx_acone "
"hardware:=mock\n"

