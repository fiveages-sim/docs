"cd ~/\n"
"git clone https://github.com/fiveages-sim/fa-py-libraries.git\n"
"cd fa-py-libraries\n"
"./init.sh all    # Python 3.12 env; installs ros2_robot_interface and "
"related submodules\n"
msgstr ""
"cd ~/\n"
"git clone https://github.com/fiveages-sim/fa-py-libraries.git\n"
"cd fa-py-libraries\n"
"./init.sh all    # Python 3.12 env; installs ros2_robot_interface and "
"related submodules\n"

#: ../../source/0-overview/2-learning_path.md:135
#: bc7ec9b640d24759903a64843b147611
msgid "Write a simple script:"
msgstr "编写一个简单脚本："

#: ../../source/0-overview/2-learning_path.md:136
#: 84a9a47ee64b4c60b61add8205c9cc62
msgid ""
"from ros2_robot_interface import ROS2RobotInterface, "
"ROS2RobotInterfaceConfig\n"
"\n"
"interface = ROS2RobotInterface(ROS2RobotInterfaceConfig())\n"
"interface.connect()\n"
"joint_state = interface.get_joint_state()\n"
"pose = interface.left_arm_handler.get_pose()\n"
msgstr ""
"from ros2_robot_interface import ROS2RobotInterface, "
"ROS2RobotInterfaceConfig\n"
"\n"
"interface = ROS2RobotInterface(ROS2RobotInterfaceConfig())\n"
"interface.connect()\n"
"joint_state = interface.get_joint_state()\n"
"pose = interface.left_arm_handler.get_pose()\n"

