#: 61734439d45f4f788730c6fed88722b8
msgid ""
"git clone https://github.com/fiveages-sim/open-deploy-ws.git\n"
"cd open-deploy-ws\n"
"./init_repo.sh\n"
msgstr ""
"git clone https://github.com/fiveages-sim/open-deploy-ws.git\n"
"cd open-deploy-ws\n"
"./init_repo.sh\n"

