#: 26638bc3a9bf40038a82d76ecf55eadf
msgid ""
"cd ~/\n"
"git clone https://github.com/fiveages-sim/fa-py-libraries.git\n"
"cd fa-py-libraries\n"
"./init.sh all    # Python 3.12 env; installs ros2_robot_interface and related submodules\n"
msgstr ""
"cd ~/\n"
"git clone https://github.com/fiveages-sim/fa-py-libraries.git\n"
"cd fa-py-libraries\n"
"./init.sh all    # Python 3.12 env; installs ros2_robot_interface and related submodules\n"

