#: ../../source/0-overview/2-learning_path.md:123
#: 82b7a3125c064fd5ad79672c32604777
msgid "**Goal:** Control the robot programmatically."
msgstr "**目标：** 以编程方式控制机器人。"

#: ../../source/0-overview/2-learning_path.md:126
#: 657601e1a86645b3b6bbce4e97a4ae97
msgid "Install fa-py-libraries:"
msgstr "安装 fa-py-libraries："

#: ../../source/0-overview/2-learning_path.md:127
#: 167ad524cad74140a40cdef1e4b4c743
msgid ""
"cd ~/\n"
"git clone https://github.com/fiveages-sim/fa-py-libraries.git\n"
"cd fa-py-libraries\n"
"./init.sh all    # Python 3.12 env; installs ros2_robot_interface and "
"related submodules\n"
msgstr ""
"cd ~/\n"
"git clone https://github.com/fiveages-sim/fa-py-libraries.git\n"
"cd fa-py-libraries\n"
"./init.sh all    # Python 3.12 env; installs ros2_robot_interface and "
"related submodules\n"

#: ../../source/0-overview/2-learning_path.md:133
#: 3376b561522d48a4a2e023ba293bb22a
msgid "Write a simple script:"
msgstr "编写一个简单脚本："

#: ../../source/0-overview/2-learning_path.md:134
#: bffde7a6ff96429aa3b84c500ad4b1aa
msgid ""
"from ros2_robot_interface import ROS2RobotInterface, "
"ROS2RobotInterfaceConfig\n"
"\n"
"interface = ROS2RobotInterface(ROS2RobotInterfaceConfig())\n"
"interface.connect()\n"
"joint_state = interface.get_joint_state()\n"
"pose = interface.left_arm_handler.get_pose()\n"
msgstr ""
"from ros2_robot_interface import ROS2RobotInterface, ROS2RobotInterfaceConfig\n\ninterface = ROS2RobotInterface(ROS2RobotInterfaceConfig())\ninterface.connect()\njoint_state = interface.get_joint_state()\npose = interface.left_arm_handler.get_pose()\n"

