msgid "**ARX Acone (CAN bus):**"
msgstr "**ARX Acone (CAN 总线 bus):**"

#: ../../source/0-overview/2-learning_path.md:182
#: 5c269927b7f04670a11b11fac4551c42
msgid ""
"cd ~/open-deploy-ws\n"
"source install/setup.bash\n"
"\n"
"# Configure CAN interface\n"
"sudo ip link set can0 type can bitrate 1000000\n"
"sudo ip link set can0 up\n"
"\n"
"# Deploy to real hardware\n"
"ros2 launch ocs2_arm_controller demo.launch.py robot:=arx_acone "
"hardware:=real\n"
msgstr ""
"cd ~/open-deploy-ws\\nsource install/setup.bash\\n\\n# Configure CAN "
"interface\\nsudo ip link set can0 type can bitrate 1000000\\nsudo ip link"
" set can0 up\\n\\n# Deploy to real hardware\\nros2 launch "
"ocs2_arm_controller demo.launch.py robot:=arx_acone hardware:=real\\n"

