#: ../../source/0-overview/2-learning_path.md:121
#: 3e60ebcebc304431afe3de092d5ef499
msgid "ros2 launch ocs2_arm_controller demo.launch.py hardware:=isaac\n"
msgstr "ros2 launch ocs2_arm_controller demo.launch.py hardware:=isaac\n"

#: ../../source/0-overview/2-learning_path.md:125
