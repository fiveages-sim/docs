#: ../../source/1-getting_started/2-install_environment.md:15
#: a74f7830a3c14133bf5cead0e867c451
msgid "Option A: Official Installation (Recommended)"
msgstr "方案 A：官方安装（推荐）"

#: ../../source/1-getting_started/2-install_environment.md:17
#: f6fe5c15fded48a3ba4d38c8d10ab43b
msgid "Follow the official ROS 2 Jazzy installation guide:"
msgstr "请按照官方 ROS 2 Jazzy 安装指南操作："

#: ../../source/1-getting_started/2-install_environment.md:19
#: 598c771b56d24841a3efd7f902f85ed0
msgid ""
"# Set locale\n"
"sudo apt update && sudo apt install locales\n"
"sudo locale-gen en_US en_US.UTF-8\n"
"sudo update-locale LC_ALL=en_US.UTF-8 LANG=en_US.UTF-8\n"
"export LANG=en_US.UTF-8\n"
"\n"
"# Add ROS 2 repository\n"
"sudo apt install software-properties-common\n"
"sudo add-apt-repository universe\n"
"sudo apt update && sudo apt install curl -y\n"
"sudo curl -sSL "
"https://raw.githubusercontent.com/ros/rosdistro/master/ros.key -o "
"/usr/share/keyrings/ros-archive-keyring.gpg\n"
"echo \"deb [arch=$(dpkg --print-architecture) signed-"
"by=/usr/share/keyrings/ros-archive-keyring.gpg] "
"http://packages.ros.org/ros2/ubuntu $(. /etc/os-release && echo "
"$UBUNTU_CODENAME) main\" | sudo tee /etc/apt/sources.list.d/ros2.list > "
"/dev/null\n"
"\n"
"# Install ROS 2 Jazzy\n"
"sudo apt update\n"
"sudo apt install ros-jazzy-desktop ros-dev-tools\n"
msgstr ""
"# Set locale\n"
"sudo apt update && sudo apt install locales\n"
"sudo locale-gen en_US en_US.UTF-8\n"
"sudo update-locale LC_ALL=en_US.UTF-8 LANG=en_US.UTF-8\n"
"export LANG=en_US.UTF-8\n"
"\n"
"# Add ROS 2 repository\n"
"sudo apt install software-properties-common\n"
"sudo add-apt-repository universe\n"
"sudo apt update && sudo apt install curl -y\n"
"sudo curl -sSL https://raw.githubusercontent.com/ros/rosdistro/master/ros.key -o /usr/share/keyrings/ros-archive-keyring.gpg\n"
"echo \"deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/ros-archive-keyring.gpg] http://packages.ros.org/ros2/ubuntu $(. /etc/os-release && echo $UBUNTU_CODENAME) main\" | sudo tee /etc/apt/sources.list.d/ros2.list > /dev/null\n"
"\n"
"# Install ROS 2 Jazzy\n"
"sudo apt update\n"
"sudo apt install ros-jazzy-desktop ros-dev-tools\n"

