"git clone https://github.com/fiveages-sim/robot-descriptions-common.git "
"src/robot-descriptions/common\n"
"./scripts/install_core_debs.sh --only ocs2"
msgstr ""
"# after the HTTPS clone of open-deploy-ws — matches init defaults "
"(ocs2=deb, arms/common=source)\n"
"git clone https://github.com/fiveages-sim/arms_ros2_control.git "
"src/arms_ros2_control\n"
"git clone https://github.com/fiveages-sim/robot_descriptions.git src"
