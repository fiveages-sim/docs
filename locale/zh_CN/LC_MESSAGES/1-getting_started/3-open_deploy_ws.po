#: 249507b75f1740ad876a64905dcce280
msgid ""
"# Acone arm (not Lift 2S). Omit hardware:= to keep mock_components.\n"
"ros2 launch ocs2_arm_controller demo.launch.py robot:=arx_acone\n"
msgstr ""
"# Acone arm (not Lift 2S). Omit hardware:= to keep mock_components.\n"
