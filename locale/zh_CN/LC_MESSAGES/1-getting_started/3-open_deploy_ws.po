"git clone -b arx-lift2s git@github.com:fiveages-sim/open-deploy-ws.git "
"lift2s-ws\n"
"# HighTorque Panthera HT\n"
"git clone -b panthera-ht git@github.com:fiveages-sim/open-deploy-ws.git "
"ht-deploy-ws"
