#: 0c56a33af36848a590b0c85fce3c16cc
msgid ""
"git clone https://github.com/fiveages-sim/open-deploy-ws.git\n"
"cd open-deploy-ws\n"
msgstr ""
"git clone https://github.com/fiveages-sim/open-deploy-ws.git\n"
