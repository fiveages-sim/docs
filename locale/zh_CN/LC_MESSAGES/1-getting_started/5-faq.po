#: 3e43139dc17f47deae40bbd442583b07
msgid "Runtime Issues"
msgstr "运行时问题"

#: ../../source/1-getting_started/5-faq.md:131
#: 78723b0eddef403fbf4a84cb25e2021e
msgid "Q: Node/topic not found"
msgstr "问：找不到节点/话题"

#: ../../source/1-getting_started/5-faq.md:133
#: 269d850cac8643d2850b868aeb98cd42
msgid "Ensure workspace is sourced:"
msgstr "确认已加载工作空间环境："

#: ../../source/1-getting_started/5-faq.md:135
#: 555cd6a634f3452db1385788def96a25
msgid "source install/setup.bash\n"
msgstr "source install/setup.bash\n"

#: ../../source/1-getting_started/5-faq.md:139
#: 66f192f27cde45f1accbcee071d20595
msgid "Check if the node is running:"
msgstr "检查节点是否在运行："

#: ../../source/1-getting_started/5-faq.md:141
#: b15b0dbd3c4a4f4f8f29d01a970514f6
msgid ""
"ros2 node list\n"
"ros2 topic list\n"
msgstr ""
"ros2 node list\n"
"ros2 topic list\n"

#: ../../source/1-getting_started/5-faq.md:146
#: 108f5bcce2c040c69b20c82278a08cae
msgid "Q: Controller fails to start"
msgstr "问：控制器无法启动"

#: ../../source/1-getting_started/5-faq.md:148
#: fe1989c6ad554cd3a513be0dae97606c
msgid "Check that:"
msgstr "请检查："

#: ../../source/1-getting_started/5-faq.md:149
#: 840cd2e3493940bfaf6a2322dda1e7ec
msgid ""
"Hardware parameter matches your setup (`mock_components`, `gz`, `isaac`, or "
