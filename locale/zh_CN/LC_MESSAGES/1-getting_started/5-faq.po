msgid "Q: Controller fails to start"
msgstr "问：控制器无法启动"

#: ../../source/1-getting_started/5-faq.md:146 17900fb99bc2428991221467df768bfd
msgid "Check that:"
msgstr "请检查："

#: ../../source/1-getting_started/5-faq.md:147 0f5d34b5cca54c5b9391ab86d5382596
msgid ""
"Hardware parameter matches your setup (`mock_components`, `gz`, `isaac`, "
