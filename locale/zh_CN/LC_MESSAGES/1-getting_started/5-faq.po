#: ../../source/1-getting_started/5-faq.md:70 3ce7df2d3f76442f8df4ca73d75ac0d1
msgid "rosdep install --from-paths src --ignore-src -r -y\n"
msgstr "rosdep install --from-paths src --ignore-src -r -y\n"

#: ../../source/1-getting_started/5-faq.md:74 59055d8378ff4faabd25cdd231c09f04
msgid "Q: numpy version conflict"
msgstr "问：numpy 版本冲突"

