msgstr "colcon build --parallel-workers 2\n"

#: ../../source/1-getting_started/5-faq.md:94 e1c20094f5e44797b49689f544352257
msgid "Or build specific packages:"
msgstr "或者只编译指定软件包："

#: ../../source/1-getting_started/5-faq.md:96 ec3b99bf890a4074a3fc71160f8b9117
msgid "colcon build --packages-up-to <package-name>\n"
msgstr "colcon build --packages-up-to <package-name>\n"

#: ../../source/1-getting_started/5-faq.md:100 34e4b2b8bcf54c99ad1194057f0f2ee1
