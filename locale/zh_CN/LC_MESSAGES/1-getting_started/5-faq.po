#: ../../source/1-getting_started/5-faq.md:149 79aa6b261bb54361bc5538ab4bcbcdad
msgid ""
"Required hardware interface plugins are initialized (`ros2 control "
"list_hardware_interfaces`)"
msgstr ""
"所需驱动层插件已初始化（`ros2 control list_hardware_interfaces`）"

#: ../../source/1-getting_started/5-faq.md:151 8f271ac260a6498aaebaea88faf36a6d
msgid "ros2 launch ocs2_arm_controller demo.launch.py\n"
msgstr "ros2 launch ocs2_arm_controller demo.launch.py\n"

#: ../../source/1-getting_started/5-faq.md:155 59127511f06247dd949b0926dd4c9182
msgid "Q: No communication between machines"
msgstr "问：机器之间无法通信"

#: ../../source/1-getting_started/5-faq.md:157 a25767c0eedc4410acbe604d7620b87e
msgid "Verify:"
