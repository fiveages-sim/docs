#: ../../source/1-getting_started/5-faq.md:149 76425d6e742247a8b27bff982364490d
msgid "Required hardware interfaces are initialized"
msgstr "所需硬件接口已初始化"

#: ../../source/1-getting_started/5-faq.md:151 3317edb3088646af98622c828cfb0b81
msgid "ros2 launch ocs2_arm_controller demo.launch.py\n"
msgstr "ros2 launch ocs2_arm_controller demo.launch.py\n"

#: ../../source/1-getting_started/5-faq.md:155 bf5fb43e8ea8484895a833d51dc64e42
msgid "Q: No communication between machines"
msgstr "问：机器之间无法通信"

#: ../../source/1-getting_started/5-faq.md:157 97247204a13b47dea69123a94c6e3a2c
msgid "Verify:"
msgstr "请确认："

