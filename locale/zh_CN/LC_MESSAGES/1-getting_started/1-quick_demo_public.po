#: 1c3f39ee99474cf5b7389a50494d5975
msgid "**RViz** window with robot visualization"
msgstr ""

#: ../../source/1-getting_started/1-quick_demo_public.md:67
#: 626dca1b18d7478d9b01c795b3b5d8ff
msgid "**Terminal** output showing controller status"
msgstr ""

#: ../../source/1-getting_started/1-quick_demo_public.md:68
#: bf9337836b3b46b8b39e5d5ce70498b2
msgid "Robot responding to MPC target commands"
msgstr ""

#: ../../source/1-getting_started/1-quick_demo_public.md:70
#: 36c2bde39c724039a1edb8dd409dee3f
msgid "To send a target pose:"
msgstr ""

#: ../../source/1-getting_started/1-quick_demo_public.md:71
#: c27d29b4bb8d41559f9b5e9a5b525646
#, python-brace-format
msgid ""
"# In a new terminal\n"
"source install/setup.bash\n"
"ros2 topic pub /target_pose geometry_msgs/msg/PoseStamped \"{header: "
"{frame_id: 'base_link'}, pose: {position: {x: 0.3, y: 0.0, z: 0.4}, "
"orientation: {w: 1.0}}}\" --once\n"
msgstr ""

