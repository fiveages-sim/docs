#: ../../source/6-synthetic_data/2-orchestration.md:64
#: 1d039912d33d414ea2b30f7b381de0ef
msgid ""
"Run from a directory that contains `robots/` (usually `examples/IsaacSim`):"
msgstr "在包含 `robots/` 的目录下运行（通常是 `examples/IsaacSim`）："

#: ../../source/6-synthetic_data/2-orchestration.md:66
#: 0aa068b1bd404f2b94728fc4c3107eef
msgid ""
"cd examples/IsaacSim\n"
"\n"
"# Scene-level OCS2 + Nav2 (background logs under .ros2_stack/<robot>/)\n"
"ros2-stack --lang zh launch\n"
"ros2-stack status\n"
"ros2-stack stop\n"
"\n"
"# Task queue (dry motion; optional --ensure-ros2-stack)\n"
"motion-generation\n"
"motion-generation --robot dobot_cr5 --task-key pick_place --scene default\n"
"motion-generation --robot fiveages_w2 --task-key transfer_blade --ensure-ros2-stack"
msgstr ""
"cd examples/IsaacSim\n"
"\n"
"# Scene-level OCS2 + Nav2 (background logs under .ros2_stack/<robot>/)\n"
"ros2-stack --lang zh launch\n"
"ros2-stack status\n"
"ros2-stack stop\n"
"\n"
"# Task queue (dry motion; optional --ensure-ros2-stack)\n"
"motion-generation\n"
"motion-generation --robot dobot_cr5 --task-key pick_place --scene default\n"
"motion-generation --robot fiveages_w2 --task-key transfer_blade --ensure-ros2-stack"

#: ../../source/6-synthetic_data/2-orchestration.md:80
#: 9f68c20120304576ab131a2da91d0366
