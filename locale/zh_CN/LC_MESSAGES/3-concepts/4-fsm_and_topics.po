#: 72be9232ecb74116ac5cc945f5f1854d
msgid "`bimanual_state` = `1` (`BIMANUAL_COUPLED`)"
msgstr "`bimanual_state` = `1` (`BIMANUAL_COUPLED`)"

#: ../../source/3-concepts/4-fsm_and_topics.md:178
#: 86dfa98162a84cf6a124ef0fdd007e8f
msgid "`has_bimanual_coupling`, and both arms enabled"
msgstr "`has_bimanual_coupling`，且左右臂均已启用"

#: ../../source/3-concepts/4-fsm_and_topics.md:178
#: 934cf2bf10c5421a8230209e800e4cff
msgid "`LEFT_ARM_ENABLE` / `LEFT_ARM_DISABLE`"
msgstr "`LEFT_ARM_ENABLE` / `LEFT_ARM_DISABLE`"

#: ../../source/3-concepts/4-fsm_and_topics.md:178
#: f3b924e0b9e84b0486b5c3145b9b1947
msgid "`left_arm_state` = `1` (`ARM_ENABLED`) or `0` (`ARM_DISABLED`)"
msgstr "`left_arm_state` = `1` (`ARM_ENABLED`) or `0` (`ARM_DISABLED`)"

#: ../../source/3-concepts/4-fsm_and_topics.md:178
#: 52bec887ea3c41ac9a868169b8b282e1 8b1a98393a8a4a2bb92b2dcd67c680c6
msgid "Arms must already be independent"
msgstr "双臂必须已经处于独立模式"

#: ../../source/3-concepts/4-fsm_and_topics.md:178
#: f343e2456d62416a8d0126837d944771
