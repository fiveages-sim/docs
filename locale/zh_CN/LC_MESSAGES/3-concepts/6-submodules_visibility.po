#: b70481a206b94aa28e761f4ba7fef799
msgid ""
"[submodule \"path/to/new-package\"]\n"
"    path = path/to/new-package\n"
"    url = https://github.com/fiveages-sim/new-package.git"
msgstr ""
"[submodule \"path/to/new-package\"]\n"
"    path = path/to/new-package\n"
"    url = https://github.com/fiveages-sim/new-package.git"

