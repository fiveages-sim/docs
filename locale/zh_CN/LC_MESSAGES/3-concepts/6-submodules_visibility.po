#: 6105ae9080944c9ea9d6e4536679d068
msgid ""
"arms_ros2_control/\n"
"├── hardware/\n"
"│   ├── arx-ros2-control/      # Public\n"
"│   ├── rokae-ros2-control/    # Private\n"
"│   └── ...\n"
"└── library/\n"
"    ├── ocs2-wbc-controller/   # Private\n"
"    └── ...\n"
msgstr ""
"arms_ros2_control/\n"
"├── hardware/\n"
"│   ├── arx-ros2-control/      # Public\n"
"│   ├── rokae-ros2-control/    # Private\n"
"│   └── ...\n"
"└── library/\n"
"    ├── ocs2-wbc-controller/   # Private\n"
"    └── ...\n"

#: ../../source/3-concepts/6-submodules_visibility.md:170
#: 1f9d1369c6a142c4aa82d66819e91065
msgid ""
"The init script handles nested visibility automatically. If manually "
"initializing:"
msgstr "初始化脚本会自动处理嵌套可见性。若手动初始化："

#: ../../source/3-concepts/6-submodules_visibility.md:172
#: fd99fbd079a3493db73e4c415b1c037d
msgid ""
"# Init parent first\n"
"git submodule update --init src/arms_ros2_control\n"
"\n"
"# Then specific children\n"
"cd src/arms_ros2_control\n"
"git submodule update --init hardware/arx-ros2-control\n"
msgstr ""
"# Init parent first\n"
"git submodule update --init src/arms_ros2_control\n"
"\n"
"# Then specific children\n"
"cd src/arms_ros2_control\n"
"git submodule update --init hardware/arx-ros2-control\n"

