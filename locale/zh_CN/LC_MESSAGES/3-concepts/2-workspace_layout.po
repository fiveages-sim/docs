#: ../../source/3-concepts/2-workspace_layout.md:36
#: eac22e2c58694aa6a02af5c149956ad7
msgid ""
"fa-deploy-ws/\n"
"├── src/\n"
"│   ├── arms_ros2_control/           # Same as open-deploy-ws\n"
"│   │   └── library/                 # Additional private submodules\n"
"│   │       ├── ocs2-wbc-controller/\n"
"│   │       ├── ocs2-humanoid/\n"
"│   │       └── lina_planning/\n"
