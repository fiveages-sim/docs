#: ../../source/3-concepts/2-workspace_layout.md:93
#: f3e66ee113a947c9b86b9eae9343fb34
msgid "Initialization"
msgstr "初始化"

#: ../../source/3-concepts/2-workspace_layout.md:95
#: 5153017f5ee44560b28bf14058fa990e
msgid "**Don't use blind recursive init:**"
msgstr "**不要盲目进行递归初始化：**"

#: ../../source/3-concepts/2-workspace_layout.md:97
#: 7fca79b33cef4fddb6bc30bc909d39ca
msgid ""
"# AVOID - initializes everything including private modules\n"
"git submodule update --init --recursive\n"
"\n"
"# BETTER - use the init script\n"
"./init_repo.sh\n"
msgstr ""
"# AVOID - initializes everything including private modules\n"
"git submodule update --init --recursive\n"
"\n"
"# BETTER - use the init script\n"
"./init_repo.sh\n"

#: ../../source/3-concepts/2-workspace_layout.md:105
#: 8013046f95134e76b645ecd703dd0f4a
msgid ""
"The init script respects visibility and only initializes appropriate "
"submodules."
msgstr "初始化脚本会遵守可见性配置，只初始化相应的子模块。"

#: ../../source/3-concepts/2-workspace_layout.md:107
#: 2b8aefbee6b34e0ba6c2da436b289179
msgid "Build Outputs"
msgstr "编译产物"

#: ../../source/3-concepts/2-workspace_layout.md:109
#: 37cb4525c52842fcab77047310169191
msgid "After building:"
msgstr "编译完成后："

#: ../../source/3-concepts/2-workspace_layout.md:111
#: ccc15ad56fc643a59ef893c28236b8bf
msgid ""
"workspace/\n"
"├── build/              # Build artifacts\n"
"│   ├── package_a/\n"
"│   └── package_b/\n"
"├── install/            # Installed packages\n"
"│   ├── setup.bash      # Source this!\n"
"│   ├── package_a/\n"
"│   └── package_b/\n"
"└── log/                # Build logs\n"
msgstr ""
"workspace/\n"
"├── build/              # Build artifacts\n"
"│   ├── package_a/\n"
"│   └── package_b/\n"
"├── install/            # Installed packages\n"
"│   ├── setup.bash      # Source this!\n"
"│   ├── package_a/\n"
"│   └── package_b/\n"
"└── log/                # Build logs\n"

#: ../../source/3-concepts/2-workspace_layout.md:123
#: 424bf8912c7844b98002077315cf4e34
msgid "**Always source from install:**"
msgstr "**始终从 install 进行 source：**"

#: ../../source/3-concepts/2-workspace_layout.md:125
#: 783a9f503801468da517c901dbea1b75
msgid ""
"source install/setup.bash  # Correct\n"
"source build/...           # Wrong!\n"
msgstr ""
"source install/setup.bash  # Correct\n"
"source build/...           # Wrong!\n"

#: ../../source/3-concepts/2-workspace_layout.md:130
#: 46991268af204ebda49920a424d11fb8
msgid "Package Dependencies"
msgstr "软件包依赖"

#: ../../source/3-concepts/2-workspace_layout.md:132
#: 134967d0335d43eaaf766d3e69c2f9e3
msgid "Dependencies flow downward:"
msgstr "依赖关系自上而下："

#: ../../source/3-concepts/2-workspace_layout.md:134
#: 7a3d1e7d5d4c46afb3dd2572fbe22282
msgid ""
"Controllers (ocs2_arm_controller)\n"
"      ↓ depends on\n"
"Hardware Interfaces (*-ros2-control)\n"
"      ↓ depends on\n"
"Descriptions (*-description)\n"
"      ↓ depends on\n"
"Common (robot-descriptions-common)\n"
msgstr ""
"控制器（ocs2_arm_controller）\n"
"      ↓ 依赖于\n"
"硬件接口（*-ros2-control）\n"
"      ↓ 依赖于\n"
"描述文件（*-description）\n"
"      ↓ 依赖于\n"
"公共组件（robot-descriptions-common）\n"

#: ../../source/3-concepts/2-workspace_layout.md:144
#: 12da3329f0c641c1bfb4ea1b7f31ff92
msgid "Build with `--packages-up-to` to build a package and its dependencies:"
msgstr "使用 `--packages-up-to` 编译某个软件包及其依赖："

#: ../../source/3-concepts/2-workspace_layout.md:146
#: ddde835279c246ac9d97b065f1f2f81b
msgid "colcon build --packages-up-to ocs2_arm_controller\n"
msgstr ""
"colcon build --packages-up-to ocs2_arm_controller\n"

#: ../../source/3-concepts/2-workspace_layout.md:150
#: e69ae5a85fb24464a825348694cf6c96
msgid "Working with Submodules"
msgstr "使用子模块"

#: ../../source/3-concepts/2-workspace_layout.md:152
#: dd1331255ad7498bb73dd812bfd80ee5
msgid "Check Status"
msgstr "检查状态"

#: ../../source/3-concepts/2-workspace_layout.md:154
#: 1fa7e7aeb3c545f0b692b1f069538be6
msgid "git submodule status\n"
msgstr ""
"git submodule status\n"

#: ../../source/3-concepts/2-workspace_layout.md:158
#: 64fad860dd3440ac9f2e5834a6f0dd1c
msgid "Update One Submodule"
msgstr "更新单个子模块"

#: ../../source/3-concepts/2-workspace_layout.md:160
#: aebf243a485748f29db9776d1150c6c9
msgid ""
"cd src/arms_ros2_control\n"
"git fetch origin\n"
"git checkout main\n"
"git pull\n"
msgstr ""
"cd src/arms_ros2_control\n"
"git fetch origin\n"
"git checkout main\n"
"git pull\n"

#: ../../source/3-concepts/2-workspace_layout.md:167
#: 063127f6fcf64a83b3105812e7ecf250
msgid "Update All (Carefully)"
msgstr "更新全部（请谨慎）"

#: ../../source/3-concepts/2-workspace_layout.md:169
#: 3733521898f847f1b34c385fbbb24b13
msgid "git submodule update --remote\n"
msgstr ""
"git submodule update --remote\n"

#: ../../source/3-concepts/2-workspace_layout.md:173
#: baff8fbf59104253b84a8e1f3d746d41
msgid "Reset to Pinned Versions"
msgstr "重置为锁定版本"

#: ../../source/3-concepts/2-workspace_layout.md:175
#: 33a0ea316ed84a5a90e74898014409ff
msgid "git submodule update --init\n"
