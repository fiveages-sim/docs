#: cc89cde9528444c083b539f2d30cdc33
msgid "After building:"
msgstr "编译完成后："

#: ../../source/3-concepts/2-workspace_layout.md:112
#: 38991c9a1c0d4ca78d77d0994c60b768
msgid ""
"workspace/\n"
"├── build/              # Build artifacts\n"
"│   ├── package_a/\n"
"│   └── package_b/\n"
"├── install/            # Installed packages\n"
"│   ├── setup.bash      # Source this!\n"
"│   ├── package_a/\n"
"│   └── package_b/\n"
"└── log/                # Build logs"
msgstr ""
"workspace/\n"
"├── build/              # Build artifacts\n"
"│   ├── package_a/\n"
"│   └── package_b/\n"
"├── install/            # Installed packages\n"
"│   ├── setup.bash      # Source this!\n"
"│   ├── package_a/\n"
"│   └── package_b/\n"
"└── log/                # Build logs"

#: ../../source/3-concepts/2-workspace_layout.md:124
#: 0aaf1e9a40504819b90b4dbd4239d8d9
msgid "**Always source from install:**"
msgstr "**始终从 install 进行 source：**"

