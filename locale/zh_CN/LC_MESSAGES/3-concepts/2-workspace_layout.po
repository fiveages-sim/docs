#: ../../source/3-concepts/2-workspace_layout.md:93
#: c131d4b910b44f58888783e65236ef32
msgid "Initialization"
msgstr "初始化"

#: ../../source/3-concepts/2-workspace_layout.md:95
#: bb7fddd3d4ce4997a104a782b07c7204
msgid "**Don't use blind recursive init:**"
msgstr "**不要盲目进行递归初始化：**"

#: ../../source/3-concepts/2-workspace_layout.md:97
#: 9b5f058fedc74cd4a6ec7010c3c0fd14
msgid ""
"# AVOID - initializes everything including private modules\n"
"git submodule update --init --recursive\n"
"\n"
"# BETTER - use the init script\n"
"./init_repo.sh\n"
msgstr ""
"# AVOID - initializes everything including private modules\n"
"git submodule update --init --recursive\n"
"\n"
"# BETTER - use the init script\n"
"./init_repo.sh\n"

#: ../../source/3-concepts/2-workspace_layout.md:105
#: 42f61fc9d6d54bbf8aa52bd7635de9a4
msgid ""
"The init script respects visibility and only initializes appropriate "
"submodules."
msgstr "初始化脚本会遵守可见性配置，只初始化相应的子模块。"

#: ../../source/3-concepts/2-workspace_layout.md:107
#: 1f57dfd50b0e460583160e8393ffefc8
