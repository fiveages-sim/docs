#: 5993de7beab349a98751ed9647f3966f
msgid ""
"source install/setup.bash  # Correct\n"
"source build/...           # Wrong!\n"
msgstr ""
"source install/setup.bash  # Correct\n"
"source build/...           # Wrong!\n"

#: ../../source/3-concepts/2-workspace_layout.md:131
#: f1a9573072cd43b7a0c9acad05298d20
