"git submodule update --init\n"

#: ../../source/3-concepts/2-workspace_layout.md:179
#: 1a0de80997764c2087fef8c645e80753
msgid "Best Practices"
msgstr "最佳实践"

#: ../../source/3-concepts/2-workspace_layout.md:181
#: e69a9b62c33e47dc96fe5ee345da91fc
msgid "**Use init scripts** — They handle visibility and dependencies"
msgstr "**使用初始化脚本** — 它们会处理可见性与依赖"

#: ../../source/3-concepts/2-workspace_layout.md:182
#: 53bfacaf8053436ba452db8a84142ace
msgid ""
"**Don't commit submodule changes accidentally** — Check `git status` in "
"root"
msgstr "**不要意外提交子模块变更** — 在仓库根目录检查 `git status`"

#: ../../source/3-concepts/2-workspace_layout.md:183
#: 0f41ea94e2324630b7ce3646e002dc52
msgid "**Build incrementally** — Use `--packages-up-to` for faster iteration"
msgstr "**增量编译** — 使用 `--packages-up-to` 以加快迭代"

#: ../../source/3-concepts/2-workspace_layout.md:184
#: e739d2cad0c644acb42a9e66f19fea2b
msgid "**Keep workspaces separate** — Don't mix open-deploy-ws and fa-deploy-ws"
msgstr "**保持工作空间分离** — 不要混用 open-deploy-ws 与 fa-deploy-ws"
