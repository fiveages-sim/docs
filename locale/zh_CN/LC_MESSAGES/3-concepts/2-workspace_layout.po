msgid "Initialization"
msgstr "初始化"

#: ../../source/3-concepts/2-workspace_layout.md:96
#: 41d901977f7a40479d012a760e19ac5f
msgid "**Don't use blind recursive init:**"
msgstr "**不要盲目进行递归初始化：**"

#: ../../source/3-concepts/2-workspace_layout.md:98
#: d84b656cfe724ee6b3255972f1630434
msgid ""
"# AVOID - initializes everything including private modules\n"
"git submodule update --init --recursive\n"
"\n"
"# BETTER - use the init script\n"
"./init_repo.sh\n"
msgstr ""
"# AVOID - initializes everything including private modules\n"
"git submodule update --init --recursive\n"
"\n"
"# BETTER - use the init script\n"
"./init_repo.sh\n"

#: ../../source/3-concepts/2-workspace_layout.md:106
#: 7f64bf5d4381417dbb4aa1df1ee27ffb
msgid ""
"The init script respects visibility and only initializes appropriate "
"submodules."
msgstr "初始化脚本会遵守可见性配置，只初始化相应的子模块。"

#: ../../source/3-concepts/2-workspace_layout.md:108
#: ed24c18bad824024bb078de641f90242
msgid "Build Outputs"
msgstr "编译产物"

